# Antigravity Daemon & RPC Client
# ---------------------------------------------------------------------------

def discover_agy_daemon() -> Optional[Dict[str, Any]]:
    """
    Finds the active Antigravity language_server daemon address and admin CSRF token.
    Always prefers the master csrfToken from `~/.gemini/antigravity/daemon/hub_*.json`
    because `ANTIGRAVITY_CSRF_TOKEN` injected inside `run_command` has restricted
    principal (`"run_command"`) that returns HTTP 403 on CreateProject/UpdateProject.
    """
    ls_addr = os.environ.get("ANTIGRAVITY_LS_ADDRESS", "").strip()
    csrf = os.environ.get("ANTIGRAVITY_CSRF_TOKEN", "").strip()

    hub_info: Optional[Dict[str, Any]] = None
    if AGY_DAEMON_DIR.exists():
        hub_files = sorted(AGY_DAEMON_DIR.glob("hub_*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
        for hf in hub_files:
            try:
                data = json.loads(hf.read_text(encoding="utf-8"))
                port = data.get("httpPort")
                token = data.get("csrfToken")
                pid = data.get("pid")
                if not port or not token:
                    continue
                if pid:
                    try:
                        os.kill(int(pid), 0)
                    except OSError:
                        continue
                hub_info = {
                    "address": f"localhost:{port}",
                    "httpPort": port,
                    "httpsPort": data.get("httpsPort"),
                    "lspPort": data.get("lspPort"),
                    "csrfToken": token,
                    "pid": pid,
                    "version": data.get("lsVersion") or data.get("version") or "2.0",
                    "hubFile": str(hf),
                    "source": "hub_file",
                }
                break
            except Exception:
                continue

    if hub_info:
        return hub_info

    if ls_addr and csrf:
        host_port = ls_addr.replace("http://", "").replace("https://", "")
        return {
            "address": host_port,
            "csrfToken": csrf,
            "pid": None,
            "version": os.environ.get("ANTIGRAVITY_LS_VERSION", "2.0"),
            "source": "env",
        }

    return None


def agy_rpc(method: str, payload: Dict[str, Any], timeout: int = 10) -> Tuple[bool, Dict[str, Any]]:
    """Calls an Antigravity LanguageServerService HTTP JSON RPC method."""
    daemon = discover_agy_daemon()
    if not daemon:
        return False, {"error": "Antigravity daemon not found"}

    addr = daemon["address"]
    token = daemon["csrfToken"]
    url = f"http://{addr}/exa.language_server_pb.LanguageServerService/{method}"
    body = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        headers={
            "Content-Type": "application/json",
            "x-codeium-csrf-token": token,
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            data = json.loads(raw) if raw.strip() else {}
            return True, data
    except urllib.error.HTTPError as he:
        err_body = he.read().decode("utf-8", errors="replace")
        return False, {"error": f"HTTP {he.code}: {err_body}"}
    except Exception as exc:
        return False, {"error": str(exc)}


def run_agentapi(
    args: List[str],
    project_id: Optional[str] = None,
    cwd: Optional[Path] = None,
    timeout: int = 30,
) -> Tuple[int, Dict[str, Any], str]:
    """Executes `~/.gemini/antigravity/bin/agentapi` safely with daemon env injected."""
    daemon = discover_agy_daemon()
    env = os.environ.copy()
    if daemon:
        env["ANTIGRAVITY_LS_ADDRESS"] = daemon["address"]
        env["ANTIGRAVITY_CSRF_TOKEN"] = daemon["csrfToken"]
    if project_id:
        env["ANTIGRAVITY_PROJECT_ID"] = project_id

    if AGENTAPI_BIN.exists():
        cmd = [str(AGENTAPI_BIN)] + args
    elif LS_BIN.exists():
        cmd = [str(LS_BIN), "agentapi"] + args
    else:
        return 1, {}, "agentapi binary not found"

    proc: Optional[subprocess.Popen] = None
    try:
        proc = subprocess.Popen(
            cmd,
            cwd=str(cwd) if cwd and cwd.exists() else None,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        out, err = proc.communicate(timeout=timeout)
        rc = proc.returncode
        parsed: Dict[str, Any] = {}
        if out and out.strip():
            try:
                parsed = json.loads(out.strip())
            except Exception:
                parsed = {"raw": out.strip()}
        return rc, parsed, (err or "").strip()
    except subprocess.TimeoutExpired:
        if proc is not None:
            proc.kill()
            proc.communicate()
        return 124, {}, f"agentapi timed out after {timeout}s"
    except Exception as exc:
        if proc is not None and proc.poll() is None:
            proc.kill()
        return 1, {}, str(exc)


