WRITE_TOOL_NAMES = {
    "write", "edit", "multiedit", "notebookedit",
    "write_file", "edit_file", "multi_edit", "create_file",
}
READ_TOOL_NAMES = {
    "read", "read_file", "view_file", "grep", "glob", "script_read", "script_grep",
}


def format_tool_result_snippet(raw_result: Any, is_error: bool = False, max_chars: int = 1800) -> str:
    """Formats a tool_result payload preserving error tracebacks, exit codes, and key outputs."""
    txt = ""
    if isinstance(raw_result, str):
        txt = raw_result.strip()
    elif isinstance(raw_result, list):
        chunks: List[str] = []
        for item in raw_result:
            if isinstance(item, str):
                chunks.append(item.strip())
            elif isinstance(item, dict):
                if item.get("type") == "text" and item.get("text"):
                    chunks.append(str(item["text"]).strip())
        txt = "\n".join(c for c in chunks if c).strip()
    elif isinstance(raw_result, dict):
        txt = json.dumps(raw_result, ensure_ascii=False)

    if not txt:
        return ""
    txt_single = " ".join(txt.split())
    if len(txt_single) > max_chars:
        half = max_chars // 2
        txt_single = (
            txt_single[:half]
            + f" ... [{len(txt_single) - max_chars} chars omitted; see .agy-bridge/sessions/ for 100% full output] ... "
            + txt_single[-half:]
        )
    prefix = "[Tool Error]" if is_error else "[Tool Result]"
    return f"{prefix}: {txt_single}"


def extract_claude_message_text(
    message_obj: Any,
    include_thinking: bool = True,
    thinking_max_chars: int = 2000,
) -> str:
    if isinstance(message_obj, str):
        return message_obj.strip()
    if not isinstance(message_obj, dict):
        return ""
    content = message_obj.get("content", "")
    if isinstance(content, str):
        return content.strip()
    if isinstance(content, list):
        parts: List[str] = []
        for item in content:
            if isinstance(item, str):
                parts.append(item)
            elif isinstance(item, dict):
                itype = item.get("type", "")
                if itype == "thinking" and include_thinking:
                    th = " ".join((item.get("thinking") or "").split())
                    if th:
                        if thinking_max_chars > 0 and len(th) > thinking_max_chars:
                            th = th[:thinking_max_chars] + " ... [full reasoning in .agy-bridge/sessions/]"
                        parts.append(f"> **[Thinking / Reasoning]**: {th}")
                elif itype == "text":
                    txt = item.get("text", "").strip()
                    if txt:
                        parts.append(txt)
                elif itype == "tool_use":
                    tname = item.get("name", "tool")
                    tinput = item.get("input", {})
                    summary_arg = ""
                    if isinstance(tinput, dict):
                        for k in ("file_path", "path", "TargetFile", "command", "CommandLine", "pattern", "url", "description"):
                            if k in tinput and isinstance(tinput[k], str):
                                summary_arg = " ".join(tinput[k].split())[:300]
                                break
                        if tname.lower() in ("edit", "edit_file") and isinstance(tinput.get("new_string") or tinput.get("Replacement"), str):
                            new_s = (tinput.get("new_string") or tinput.get("Replacement") or "").strip().replace("\n", " ")[:180]
                            if new_s:
                                summary_arg += f" -> `{new_s}`"
                    parts.append(f"[Tool Call: `{tname}` {summary_arg}]".strip())
        return "\n".join(parts).strip()
    return ""


def parse_claude_or_workbuddy_jsonl(jsonl_path: Path, max_turns: int = 0) -> Dict[str, Any]:
    """
    Parses a Claude Code or WorkBuddy .jsonl transcript with FULL FIDELITY:
    - Captures all turns (or last `max_turns` while always preserving `initialUserGoal` Turn 1)
    - Preserves `thinking` blocks (reasoning / why approaches were chosen or rejected)
    - Preserves `tool_use` AND `tool_result` (command outputs, test results, tracebacks, errors)
    - Separates `modifiedFiles` (edited/written) from `readFiles` (inspected)
    """
    turns: List[Dict[str, str]] = []
    modified_files: List[str] = []
    read_files: List[str] = []
    touched_files: List[str] = []
    cwd = ""
    branch = ""
    title = ""
    session_id = jsonl_path.stem
    mtime = jsonl_path.stat().st_mtime if jsonl_path.exists() else 0.0

    # Check if Claude Desktop local_*.json has a rich title for this session
    if CLAUDE_SESSIONS_DIR.exists():
        for lf in CLAUDE_SESSIONS_DIR.glob("*/*/local_*.json"):
            try:
                d = json.loads(lf.read_text(encoding="utf-8"))
                if d.get("cliSessionId") == session_id or d.get("sessionId") == session_id:
                    if d.get("title"):
                        title = d["title"]
                    if not branch and d.get("worktreeBranch"):
                        branch = d["worktreeBranch"]
                    if not cwd and (d.get("worktreePath") or d.get("originCwd") or d.get("cwd")):
                        cwd = d.get("worktreePath") or d.get("originCwd") or d.get("cwd") or ""
                    break
            except Exception:
                continue

    try:
        with jsonl_path.open("r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                if not cwd and rec.get("cwd"):
                    cwd = rec["cwd"]
                if not branch and rec.get("gitBranch"):
                    branch = rec["gitBranch"]
                rtype = rec.get("type", "")
                if rtype == "custom-title" and rec.get("customTitle"):
                    title = rec["customTitle"]
                    continue
                if rtype == "agent-name" and not title and rec.get("agentName"):
                    title = rec["agentName"]
                    continue
                if rtype not in ("user", "assistant"):
                    continue
                msg = rec.get("message", {})

                # Track modified vs read files from assistant tool_use blocks
                if rtype == "assistant" and isinstance(msg, dict) and isinstance(msg.get("content"), list):
                    for block in msg["content"]:
                        if isinstance(block, dict) and block.get("type") == "tool_use":
                            tname = (block.get("name") or "").lower()
                            inp = block.get("input", {})
                            if isinstance(inp, dict):
                                fp = inp.get("file_path") or inp.get("path") or inp.get("TargetFile") or inp.get("AbsolutePath")
                                if isinstance(fp, str) and fp:
                                    if fp not in touched_files:
                                        touched_files.append(fp)
                                    if tname in WRITE_TOOL_NAMES:
                                        if fp not in modified_files:
                                            modified_files.append(fp)
                                    elif fp not in read_files and fp not in modified_files:
                                        read_files.append(fp)

                # Handle user records that contain tool_result blocks vs real user messages
                if rtype == "user" and isinstance(msg, dict) and isinstance(msg.get("content"), list):
                    tool_result_lines: List[str] = []
                    user_text_lines: List[str] = []
                    for block in msg["content"]:
                        if isinstance(block, dict):
                            btype = block.get("type", "")
                            if btype == "tool_result":
                                is_err = bool(block.get("is_error"))
                                tr_str = format_tool_result_snippet(
                                    block.get("content", ""),
                                    is_error=is_err,
                                    max_chars=2400 if is_err else 900,
                                )
                                if tr_str:
                                    tool_result_lines.append(tr_str)
                            elif btype == "text":
                                ut = (block.get("text") or "").strip()
                                if ut and not (
                                    ut.startswith("<local-command")
                                    or ut.startswith("<command-name>")
                                ):
                                    user_text_lines.append(ut)
                        elif isinstance(block, str) and block.strip():
                            user_text_lines.append(block.strip())

                    if tool_result_lines and turns and turns[-1]["role"] == "assistant":
                        joined_tr = "\n".join(tool_result_lines)
                        if joined_tr not in turns[-1]["text"]:
                            turns[-1]["text"] = (turns[-1]["text"] + "\n" + joined_tr).strip()
                    if user_text_lines:
                        u_joined = "\n".join(user_text_lines).strip()
                        if u_joined:
                            turns.append({
                                "role": "user",
                                "text": u_joined,
                                "timestamp": rec.get("timestamp", ""),
                            })
                    continue

                text = extract_claude_message_text(msg, include_thinking=True, thinking_max_chars=0 if max_turns == 0 else 2000)
                if not text:
                    continue
                if rtype == "user" and (
                    text.startswith("<local-command-caveat>")
                    or text.startswith("<command-name>")
                    or text.startswith("<local-command-stdout>")
                ):
                    continue
                if turns and turns[-1]["role"] == rtype and rtype == "assistant":
                    if text not in turns[-1]["text"]:
                        turns[-1]["text"] = (turns[-1]["text"] + "\n" + text).strip()
                else:
                    turns.append({
                        "role": rtype,
                        "text": text,
                        "timestamp": rec.get("timestamp", ""),
                    })
    except Exception as exc:
        turns.append({"role": "system", "text": f"Error reading {jsonl_path}: {exc}", "timestamp": ""})

    initial_goal = ""
    for t in turns:
        if t.get("role") == "user" and t.get("text"):
            initial_goal = t["text"]
            break

    if not title and initial_goal:
        title = initial_goal.replace("\n", " ")[:90]

    ordered_touched = list(modified_files) + [f for f in touched_files if f not in modified_files]
    selected_turns = turns if (max_turns <= 0 or len(turns) <= max_turns) else turns[-max_turns:]

    return {
        "agent": "workbuddy" if ".workbuddy" in str(jsonl_path) else "claude",
        "sessionId": session_id,
        "title": title or f"Session {session_id[:8]}",
        "sourcePath": str(jsonl_path),
        "cwd": cwd,
        "branch": branch,
        "mtime": mtime,
        "lastModified": ts_to_iso(mtime),
        "initialUserGoal": initial_goal,
        "totalTurns": len(turns),
        "allTurns": turns,
        "turns": selected_turns,
        "modifiedFiles": modified_files,
        "readFiles": read_files,
        "touchedFiles": ordered_touched,
    }


def clean_agy_user_text(raw_text: str) -> str:
    """Extracts user prompt from <USER_REQUEST>...</USER_REQUEST> wrapper if present."""
    txt = raw_text.strip()
    m = re.search(r"<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>", txt, flags=re.DOTALL)
    if m:
        return m.group(1).strip()
    txt = re.sub(r"<ADDITIONAL_METADATA>.*?</ADDITIONAL_METADATA>", "", txt, flags=re.DOTALL).strip()
    txt = re.sub(r"<USER_SETTINGS_CHANGE>.*?</USER_SETTINGS_CHANGE>", "", txt, flags=re.DOTALL).strip()
    return txt


def parse_agy_session(cascade_id: str, max_turns: int = 0) -> Dict[str, Any]:
    """
    Parses an Antigravity conversation from transcript_full.jsonl / transcript.jsonl or GetCascadeTrajectorySteps RPC
    with FULL FIDELITY (preserving thinking, tool calls, tool results/errors, modified vs read files, and all turns).
    """
    turns: List[Dict[str, str]] = []
    modified_files: List[str] = []
    read_files: List[str] = []
    touched_files: List[str] = []
    cwd = ""
    project_id = ""
    last_mod_str = ""

    ok_meta, meta_resp = agy_rpc("GetAllCascadeTrajectories", {})
    title = ""
    if ok_meta:
        info = meta_resp.get("trajectorySummaries", {}).get(cascade_id, {})
        title = info.get("summary", "")
        last_mod_str = info.get("lastModifiedTime", "")
        tmeta = info.get("trajectoryMetadata", {})
        project_id = tmeta.get("projectId", "")
        w_uris = tmeta.get("workspaceUris", []) or [
            w.get("workspaceFolderAbsoluteUri", "") for w in tmeta.get("workspaces", [])
        ]
        if w_uris and w_uris[0]:
            cwd = uri_to_path(w_uris[0])

    logs_dir = AGY_BRAIN_DIR / cascade_id / ".system_generated" / "logs"
    transcript_full = logs_dir / "transcript_full.jsonl"
    transcript_compact = logs_dir / "transcript.jsonl"
    transcript_file = transcript_full if transcript_full.exists() else transcript_compact
    mtime = transcript_file.stat().st_mtime if transcript_file.exists() else iso_to_epoch(last_mod_str)

    if transcript_file.exists():
        try:
            with transcript_file.open("r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        rec = json.loads(line)
                    except Exception:
                        continue
                    stype = rec.get("type", "").upper()
                    status = rec.get("status", "").upper()
                    ts = rec.get("created_at") or rec.get("timestamp") or ""
                    if stype == "USER_INPUT":
                        txt = rec.get("content", "")
                        if isinstance(txt, str) and txt.strip():
                            cleaned = clean_agy_user_text(txt)
                            if cleaned:
                                turns.append({"role": "user", "text": cleaned, "timestamp": ts})
                    elif stype in ("PLANNER_RESPONSE", "MODEL_RESPONSE"):
                        thinking = (rec.get("thinking") or "").strip()
                        txt = rec.get("content", "")
                        tcalls = rec.get("tool_calls", [])
                        parts: List[str] = []
                        if thinking:
                            th_single = " ".join(thinking.split())
                            th_disp = th_single if max_turns == 0 or len(th_single) <= 2000 else (th_single[:2000] + " ... [full reasoning in .agy-bridge/sessions/]")
                            parts.append(f"> **[Thinking / Reasoning]**: {th_disp}")
                        if isinstance(txt, str) and txt.strip():
                            parts.append(txt.strip())
                        if isinstance(tcalls, list):
                            for tc in tcalls:
                                if isinstance(tc, dict):
                                    tname = tc.get("name", "tool")
                                    tname_low = tname.lower()
                                    targs = tc.get("args", {})
                                    if isinstance(targs, dict):
                                        raw_fp = (
                                            targs.get("TargetFile")
                                            or targs.get("AbsolutePath")
                                            or targs.get("Path")
                                            or targs.get("file_path")
                                            or targs.get("SearchPath")
                                            or targs.get("DirectoryPath")
                                        )
                                        fp = raw_fp.strip('"').strip("'") if isinstance(raw_fp, str) else ""
                                        if fp:
                                            if fp not in touched_files:
                                                touched_files.append(fp)
                                            if tname_low in WRITE_TOOL_NAMES:
                                                if fp not in modified_files:
                                                    modified_files.append(fp)
                                            elif fp not in read_files and fp not in modified_files:
                                                read_files.append(fp)
                                        raw_cmd = targs.get("CommandLine", "")
                                        cmd_str = " ".join(raw_cmd.strip('"').split())[:260] if isinstance(raw_cmd, str) else ""
                                        summary_arg = fp or cmd_str or ""
                                        parts.append(f"[Tool Call: `{tname}` {summary_arg}]".strip())
                        if parts:
                            joined_p = "\n".join(parts)
                            if turns and turns[-1]["role"] == "assistant":
                                if joined_p not in turns[-1]["text"]:
                                    turns[-1]["text"] = (turns[-1]["text"] + "\n\n" + joined_p).strip()
                            else:
                                turns.append({"role": "assistant", "text": joined_p, "timestamp": ts})
                    elif status == "ERROR" or "TOOL" in stype or "COMMAND" in stype:
                        raw_out = rec.get("content") or rec.get("error") or ""
                        if isinstance(raw_out, str) and raw_out.strip() and turns and turns[-1]["role"] == "assistant":
                            tr_snip = format_tool_result_snippet(raw_out, is_error=(status == "ERROR"), max_chars=1500)
                            if tr_snip and tr_snip not in turns[-1]["text"]:
                                turns[-1]["text"] = (turns[-1]["text"] + "\n" + tr_snip).strip()
        except Exception:
            pass

    # Fallback to GetCascadeTrajectorySteps RPC if transcript file wasn't populated
    if not turns:
        ok_steps, steps_resp = agy_rpc("GetCascadeTrajectorySteps", {"cascadeId": cascade_id})
        if ok_steps and "steps" in steps_resp:
            for st in steps_resp["steps"]:
                stype = st.get("type", "")
                ts = st.get("metadata", {}).get("createdAt", "")
                if stype == "CORTEX_STEP_TYPE_USER_INPUT":
                    ui = st.get("userInput", {})
                    items = ui.get("items", [])
                    txt = "\n".join(i.get("text", "") for i in items if isinstance(i, dict) and i.get("text")).strip()
                    if txt:
                        turns.append({"role": "user", "text": clean_agy_user_text(txt), "timestamp": ts})
                elif stype == "CORTEX_STEP_TYPE_PLANNER_RESPONSE":
                    pr = st.get("plannerResponse", {})
                    thinking = (pr.get("thinking") or "").strip()
                    txt = (pr.get("modifiedResponse") or pr.get("response") or "").strip()
                    parts_rpc: List[str] = []
                    if thinking:
                        th_disp = thinking if max_turns == 0 or len(thinking) <= 2000 else (thinking[:2000] + " ... [full reasoning in .agy-bridge/sessions/]")
                        parts_rpc.append(f"> **[Thinking / Reasoning]**: {th_disp}")
                    if txt:
                        parts_rpc.append(txt)
                    for tc in pr.get("toolCalls", []):
                        if isinstance(tc, dict):
                            tname = tc.get("name", "tool")
                            tname_low = tname.lower()
                            args_json = tc.get("argumentsJson", "{}")
                            try:
                                targs = json.loads(args_json) if isinstance(args_json, str) else {}
                            except Exception:
                                targs = {}
                            if isinstance(targs, dict):
                                raw_fp = (
                                    targs.get("TargetFile")
                                    or targs.get("AbsolutePath")
                                    or targs.get("Path")
                                    or targs.get("file_path")
                                    or targs.get("SearchPath")
                                    or targs.get("DirectoryPath")
                                )
                                fp = raw_fp.strip('"').strip("'") if isinstance(raw_fp, str) else ""
                                if fp:
                                    if fp not in touched_files:
                                        touched_files.append(fp)
                                    if tname_low in WRITE_TOOL_NAMES:
                                        if fp not in modified_files:
                                            modified_files.append(fp)
                                    elif fp not in read_files and fp not in modified_files:
                                        read_files.append(fp)
                                summary_arg = fp or str(targs.get("CommandLine", ""))[:260]
                                parts_rpc.append(f"[Tool Call: `{tname}` {summary_arg}]".strip())
                    if parts_rpc:
                        joined_rpc = "\n".join(parts_rpc)
                        if turns and turns[-1]["role"] == "assistant":
                            if joined_rpc not in turns[-1]["text"]:
                                turns[-1]["text"] = (turns[-1]["text"] + "\n\n" + joined_rpc).strip()
                        else:
                            turns.append({"role": "assistant", "text": joined_rpc, "timestamp": ts})
                elif stype == "CORTEX_STEP_TYPE_RUN_COMMAND":
                    rc_step = st.get("runCommand", {})
                    cmd_out = (rc_step.get("combinedOutput", {}).get("full") or rc_step.get("stdout") or "").strip()
                    exit_code = rc_step.get("exitCode", 0)
                    if cmd_out and turns and turns[-1]["role"] == "assistant":
                        tr_snip = format_tool_result_snippet(
                            f"(exit={exit_code}) {cmd_out}",
                            is_error=(exit_code not in (0, None)),
                            max_chars=1500,
                        )
                        if tr_snip and tr_snip not in turns[-1]["text"]:
                            turns[-1]["text"] = (turns[-1]["text"] + "\n" + tr_snip).strip()

    initial_goal = ""
    for t in turns:
        if t.get("role") == "user" and t.get("text"):
            initial_goal = t["text"]
            break

    if not title and initial_goal:
        title = initial_goal.replace("\n", " ")[:90]

    ordered_touched = list(modified_files) + [f for f in touched_files if f not in modified_files]
    selected_turns = turns if (max_turns <= 0 or len(turns) <= max_turns) else turns[-max_turns:]

    return {
        "agent": "antigravity",
        "sessionId": cascade_id,
        "title": title or f"Antigravity {cascade_id[:8]}",
        "projectId": project_id,
        "sourcePath": str(transcript_file) if transcript_file.exists() else f"rpc://GetCascadeTrajectorySteps/{cascade_id}",
        "cwd": cwd,
        "branch": "",
        "mtime": mtime,
        "lastModified": last_mod_str or ts_to_iso(mtime),
        "initialUserGoal": initial_goal,
        "totalTurns": len(turns),
        "allTurns": turns,
        "turns": selected_turns,
        "modifiedFiles": modified_files,
