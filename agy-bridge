def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agy-bridge",
        description="Universal Zero-Terminal Cross-Agent Context Bus & MCP Server (Antigravity 2.0, Claude, Codex, WorkBuddy)",
    )
    sub = parser.add_subparsers(dest="subcommand")

    # status / list
    for name in ("status", "list"):
        p_st = sub.add_parser(name, help="List active projects, live sockets, and recent sessions across all agents")
        p_st.add_argument("-n", "--limit", type=int, default=10, help="Max sessions per agent to list")
        p_st.add_argument("--json", action="store_true", help="Output JSON")
        p_st.set_defaults(func=cmd_status)

    # continue / switch / to (1-command failover)
    for name in ("continue", "switch", "to"):
        p_co = sub.add_parser(name, help="One-step failover: continue the latest active/interrupted task in another IDE")
        p_co.add_argument("target", nargs="?", default=None, help="Optional target agent ('agy', 'claude', 'codex') or project path/name")
        p_co.add_argument("target_project", nargs="?", default=None, help="Optional project path or name when first arg is agent")
        p_co.add_argument("--to", default=None, help="Target IDE ('agy', 'claude', 'codex')")
        p_co.add_argument("-w", "--workspace", "--project", "--path", dest="workspace", default=None, help="Project directory override")
        p_co.add_argument("-p", "--prompt", default=None, help="Custom continuation prompt")
        p_co.add_argument("--no-chat", action="store_true", help="Only prepare recovery state without launching chat")
        p_co.add_argument("--no-focus", action="store_true", help="Do not focus target window")
        p_co.add_argument("--json", action="store_true", help="Output JSON")
        p_co.set_defaults(func=cmd_continue)

    # sockets
    p_sk = sub.add_parser("sockets", help="List live open Claude Desktop / CLI Unix sockets (/tmp/cc-socks/*.sock)")
    p_sk.add_argument("--json", action="store_true", help="Output JSON")
    p_sk.set_defaults(func=cmd_sockets)

    # spawn-agy / create / ensure
    for name in ("spawn-agy", "create", "ensure"):
        p_sa = sub.add_parser(name, help="Create/register project with Turbo settings and optionally start an Antigravity chat")
        p_sa.add_argument("path_or_name", nargs="?", default=None, help="Project directory path or project name")
        p_sa.add_argument("positional_prompt", nargs="?", default=None, help="Initial prompt for the new conversation")
        p_sa.add_argument("-w", "--workspace", default=None, help="Explicit workspace directory path")
        p_sa.add_argument("-n", "--name", default=None, help="Explicit project name")
        p_sa.add_argument("-p", "--prompt", default=None, help="Initial prompt for the new conversation")
        p_sa.add_argument("-t", "--title", default=None, help="Title for the new conversation")
        p_sa.add_argument("-m", "--model", default=None, help="Model override for agentapi new-conversation")
        p_sa.add_argument("--project-id", default=None, help="Preferred Antigravity project UUID")
        p_sa.add_argument("--from-claude", default=None, help="Generate HANDOFF_CONTEXT.md from this Claude session before spawning")
        p_sa.add_argument("--focus", action="store_true", help="Focus the conversation in the Antigravity UI")
        p_sa.add_argument("--no-chat", "--register-only", dest="no_chat", action="store_true", help="Only create/register the project without starting a chat")
        p_sa.add_argument("--timeout", type=int, default=30, help="Timeout in seconds for agentapi call")
        p_sa.add_argument("--json", action="store_true", help="Output JSON")
        p_sa.set_defaults(func=cmd_spawn_agy)

    # send-agy
    p_snd = sub.add_parser("send-agy", help="Send a message to an existing Antigravity conversation by cascade_id or project")
    p_snd.add_argument("target", help="Conversation cascade_id, project UUID, project name, or workspace path")
    p_snd.add_argument("message", help="Message text to send")
    p_snd.add_argument("-t", "--title", default=None, help="Optional conversation title update")
    p_snd.add_argument("--focus", action="store_true", help="Focus the conversation in the Antigravity UI")
    p_snd.add_argument("--timeout", type=int, default=30, help="Timeout in seconds")
    p_snd.add_argument("--json", action="store_true", help="Output JSON")
    p_snd.set_defaults(func=cmd_send_agy)

    # send-claude
    p_scl = sub.add_parser("send-claude", help="Send a message directly into an open Claude Desktop / CLI tab via Unix socket (/tmp/cc-socks)")
    p_scl.add_argument("target", help="PID, sessionId, local_* hostSessionId, session title, or workspace path")
    p_scl.add_argument("message", help="Message text to inject into the open Claude session")
    p_scl.add_argument("--priority", default="next", choices=["now", "next", "later"], help="Queue priority (default: next)")
    p_scl.add_argument("--json", action="store_true", help="Output JSON")
    p_scl.set_defaults(func=cmd_send_claude)

    # spawn-claude
    p_sc = sub.add_parser("spawn-claude", help="Create/register project and prepare or launch Claude Code / Desktop session")
    p_sc.add_argument("path_or_name", nargs="?", default=None, help="Project directory path or name")
    p_sc.add_argument("positional_prompt", nargs="?", default=None, help="Optional prompt")
    p_sc.add_argument("-w", "--workspace", default=None, help="Explicit workspace directory path")
    p_sc.add_argument("-n", "--name", default=None, help="Explicit project name")
    p_sc.add_argument("-p", "--prompt", default=None, help="Prompt to run")
    p_sc.add_argument("-m", "--model", default=None, help="Claude model override")
    p_sc.add_argument("--desktop", action="store_true", help="Open session in Claude Desktop (`claude --desktop`)")
    p_sc.add_argument("--bg", action="store_true", help="Start background Claude session (`claude --bg`)")
    p_sc.add_argument("--print", dest="print_mode", action="store_true", help="Run non-interactive `claude -p` print mode")
    p_sc.add_argument("--register-only", action="store_true", help="Only create/register the project without launching claude CLI")
    p_sc.add_argument("--timeout", type=int, default=45, help="Timeout in seconds for print mode")
    p_sc.set_defaults(func=cmd_spawn_claude)

    # handoff
    p_ho = sub.add_parser("handoff", help="Capture full-fidelity session transcript and hand off context between Claude, Antigravity, Codex, and WorkBuddy")
    p_ho.add_argument("target", nargs="?", default=None, help="Optional project directory path or project name")
    p_ho.add_argument("--from-claude", nargs="?", const="__AUTO__", default=None, help="Source Claude session ID, local_* ID, .jsonl path, or project name")
    p_ho.add_argument("--from-agy", nargs="?", const="__AUTO__", default=None, help="Source Antigravity cascade_id or project name/path")
    p_ho.add_argument("--from-workbuddy", nargs="?", const="__AUTO__", default=None, help="Source WorkBuddy session ID or project name")
    p_ho.add_argument("--from-codex", nargs="?", const="__AUTO__", default=None, help="Source Codex thread ID or project path")
    p_ho.add_argument("--to-agy", action="store_true", help="Prepare/register target project in Antigravity (Turbo)")
    p_ho.add_argument("--to-claude", action="store_true", help="Export/update Claude Code transcript and presets")
    p_ho.add_argument("--to-codex", action="store_true", help="Register workspace in Codex")
    p_ho.add_argument("-w", "--workspace", default=None, help="Override target workspace path")
    p_ho.add_argument("-n", "--name", default=None, help="Override project name")
    p_ho.add_argument("-l", "--lines", type=int, default=0, help="Max dialogue turns (0 = unlimited/full-fidelity)")
    p_ho.add_argument("--spawn", action="store_true", help="Spawn a new conversation in the target agent after generating handoff context")
    p_ho.add_argument("-p", "--prompt", default=None, help="Custom prompt when spawning a new target conversation")
    p_ho.add_argument("-t", "--title", default=None, help="Custom title for spawned conversation")
    p_ho.add_argument("--no-chat", action="store_true", help="Generate handoff and register project without spawning a new chat")
    p_ho.add_argument("--focus", action="store_true", help="Focus the conversation in Antigravity UI")
    p_ho.set_defaults(func=cmd_handoff)

    # sync
    p_sy = sub.add_parser("sync", help="3-layer lossless sync into SQLite WAL + .agy-bridge/LIVE_STATE.md + HANDOFF_CONTEXT.md + .agy-bridge/sessions/")
    p_sy.add_argument("target", nargs="?", default=None, help="Project path or name (defaults to current working directory)")
    p_sy.add_argument("-w", "--workspace", "--project", "--path", dest="workspace", default=None, help="Explicit workspace directory path")
    p_sy.add_argument("--write-docs", action="store_true", help="Also write AUTO-STATE block into tracked CLAUDE.md/AGENTS.md")
    p_sy.add_argument("-q", "--quiet", action="store_true", help="Suppress stdout messages")
    p_sy.set_defaults(func=cmd_sync)

    # hook-sync
    p_hs = sub.add_parser("hook-sync", help="Lifecycle hook handler for Claude Code and Antigravity 2.0")
    p_hs.add_argument("-w", "--workspace", default=None, help="Optional workspace path override")
    p_hs.add_argument("--event", default=None, help="Hook event name (SessionStart, UserPromptSubmit, PreInvocation, PostToolUse, Stop, StopFailure)")
    p_hs.add_argument("--agy-hook", action="store_true", help="Output Antigravity hook JSON contract")
    p_hs.set_defaults(func=cmd_hook_sync)

    # install-hooks / init
    for name in ("install-hooks", "init"):
        p_ih = sub.add_parser(name, help="Install global zero-terminal auto-sync hooks, rules, and MCP server for Claude, Antigravity & Codex")
        p_ih.set_defaults(func=cmd_install_hooks)

    # doctor
    p_doc = sub.add_parser("doctor", help="Check health of Antigravity daemon, hooks, MCP servers, and live sockets")
    p_doc.set_defaults(func=cmd_doctor)

    # uninstall
    p_un = sub.add_parser("uninstall", help="Cleanly remove agy-bridge hooks and plugin from global configs")
    p_un.set_defaults(func=cmd_uninstall)

    # mcp
    p_mcp = sub.add_parser("mcp", help="Run built-in JSON-RPC 2.0 MCP server over stdio")
    p_mcp.set_defaults(func=cmd_mcp)

    # focus
    p_fo = sub.add_parser("focus", help="Focus an Antigravity conversation in the desktop UI")
    p_fo.add_argument("target", help="Conversation cascade_id or project name/path")
    p_fo.set_defaults(func=cmd_focus)

    return parser


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "subcommand", None):
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
