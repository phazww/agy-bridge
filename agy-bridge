    atomic_write_text(CLAUDE_SETTINGS_FILE, json.dumps(claude_settings, indent=2, ensure_ascii=False) + "\n")

    # 2. Configure Antigravity Global Plugin: ~/.gemini/config/plugins/agy-bridge/
