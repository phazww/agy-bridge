def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def ts_to_iso(ts: float) -> str:
    try:
        if ts > 1e11:
            ts = ts / 1000.0
        return dt.datetime.fromtimestamp(ts, tz=dt.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    except Exception:
        return str(ts)


def iso_to_epoch(iso_str: str) -> float:
    if not iso_str:
        return 0.0
    try:
        s = iso_str.strip()
        if s.endswith(" UTC"):
            s = s[:-4] + "+00:00"
        elif s.endswith("Z"):
            s = s[:-1] + "+00:00"
        return dt.datetime.fromisoformat(s).timestamp()
    except Exception:
        return 0.0


def path_to_uri(p: Path | str) -> str:
    resolved = str(Path(p).expanduser().resolve())
    return "file://" + urllib.parse.quote(resolved, safe="/:@-._~")


def uri_to_path(uri: str) -> str:
    if uri.startswith("file://"):
        return urllib.parse.unquote(uri[len("file://"):])
    return uri


def path_to_claude_slug(p: Path | str) -> str:
    s = str(Path(p).expanduser().resolve())
    return re.sub(r"[^a-zA-Z0-9]", "-", s)


def is_uuid(val: str) -> bool:
    return bool(re.match(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", val.strip()))


def is_non_project_dir(p: Path) -> bool:
    try:
        resolved = p.expanduser().resolve()
        return resolved in (
            HOME.resolve(),
            DEFAULT_DOCS_DIR.resolve(),
            Path("/"),
            Path("/tmp").resolve(),
            Path("/var/tmp").resolve(),
        )
    except Exception:
        return True


def run_git(repo_path: Path, args: List[str], timeout: int = 10) -> Tuple[int, str, str]:
    try:
        res = subprocess.run(
            ["git"] + args,
            cwd=str(repo_path),
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as exc:
        return 1, "", str(exc)


SECRET_PATTERNS = [
    (re.compile(r"\b(sk-ant-[a-zA-Z0-9_-]{16,})\b"), "sk-ant-[REDACTED]"),
    (re.compile(r"\b(sk-proj-[a-zA-Z0-9_-]{16,})\b"), "sk-proj-[REDACTED]"),
    (re.compile(r"\b(sk-[a-zA-Z0-9]{20,})\b"), "sk-[REDACTED]"),
    (re.compile(r"\b(ghp_[a-zA-Z0-9]{20,}|github_pat_[a-zA-Z0-9_]{20,})\b"), "ghp_[REDACTED]"),
    (re.compile(r"\b(AIza[0-9A-Za-z_-]{30,})\b"), "AIza[REDACTED]"),
    (re.compile(r"\b(xox[baprs]-[0-9A-Za-z-]{16,})\b"), "xox-[REDACTED]"),
    (re.compile(r"\b(figd_[0-9A-Za-z_-]{20,})\b"), "figd_[REDACTED]"),
    (re.compile(r"(?i)(Bearer\s+)[A-Za-z0-9._~+/=-]{24,}"), r"\1[REDACTED]"),
    (re.compile(r"(?im)^(\s*(?:[A-Z0-9_]*(?:SECRET|TOKEN|PASSWORD|API_KEY|PRIVATE_KEY)[A-Z0-9_]*)\s*=\s*)(['\"]?[^\s#'\"]{8,}['\"]?)"), r"\1[REDACTED]"),
]


def redact_secrets(text: str) -> str:
    """Redacts API keys, tokens, and .env secrets before persisting session mirrors or handoffs."""
    if not text:
        return ""
    out = text
    for pat, repl in SECRET_PATTERNS:
        out = pat.sub(repl, out)
    return out


def atomic_write_text(target: Path, content: str, mode: Optional[int] = None) -> None:
    """Writes text atomically via a temporary file in the same directory + os.replace."""
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix=f".{target.name}.", suffix=".tmp", dir=str(target.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        if mode is not None:
            try:
                os.chmod(tmp_path, mode)
            except Exception:
                pass
        os.replace(tmp_path, str(target))
    except Exception:
        try:
            os.unlink(tmp_path)
        except Exception:
            pass
        raise


def get_git_common_bridge_dir(repo_path: Path) -> Path:
    """
    Returns `$(git rev-parse --git-common-dir)/agy-bridge`, which is shared across the main repo
    and ALL git worktrees of this project, and is 100% invisible to `git status`.
    """
    try:
        rc, git_common_dir, _ = run_git(repo_path, ["rev-parse", "--git-common-dir"])
        if rc == 0 and git_common_dir:
            gdir = Path(git_common_dir)
            if not gdir.is_absolute():
                gdir = (repo_path / gdir).resolve()
            bdir = gdir / "agy-bridge"
            bdir.mkdir(parents=True, exist_ok=True)
            return bdir
    except Exception:
        pass
    fallback = repo_path / ".agy-bridge"
    fallback.mkdir(parents=True, exist_ok=True)
    return fallback


@contextlib.contextmanager
def with_repo_lock(repo_path: Path) -> Iterator[Path]:
    """Acquires an exclusive flock on `<git-common-dir>/agy-bridge/sync.lock` to prevent concurrent hook races."""
    bdir = get_git_common_bridge_dir(repo_path)
    lock_file = bdir / "sync.lock"
    lock_file.parent.mkdir(parents=True, exist_ok=True)
    f = lock_file.open("a+", encoding="utf-8")
    try:
        try:
            fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        except Exception:
            pass
        yield bdir
    finally:
        try:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)
        except Exception:
            pass
        f.close()


def get_repo_sqlite_conn(repo_path: Path) -> sqlite3.Connection:
    """Opens (and initializes) the shared SQLite WAL database in `<git-common-dir>/agy-bridge/state.sqlite`."""
    bdir = get_git_common_bridge_dir(repo_path)
    db_path = bdir / "state.sqlite"
    conn = sqlite3.connect(str(db_path), timeout=10.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("PRAGMA synchronous=NORMAL;")
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS sessions (
            session_id TEXT PRIMARY KEY,
            agent TEXT NOT NULL,
            title TEXT,
            cwd TEXT,
            branch TEXT,
            head_sha TEXT,
            total_turns INTEGER DEFAULT 0,
            initial_goal TEXT,
            last_prompt TEXT,
            last_outcome TEXT,
            modified_files_json TEXT,
            read_files_json TEXT,
            mirror_path TEXT,
            status TEXT DEFAULT 'active',
            error_info TEXT DEFAULT '',
            mtime REAL DEFAULT 0,
            updated_at TEXT
        );
        CREATE TABLE IF NOT EXISTS decisions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            agent TEXT,
            session_id TEXT,
            kind TEXT DEFAULT 'decision',
            summary TEXT NOT NULL,
            reason TEXT DEFAULT '',
            files_json TEXT DEFAULT '[]',
            head_sha TEXT DEFAULT '',
            created_at TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS events (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            event_type TEXT NOT NULL,
            agent TEXT,
            session_id TEXT,
            cwd TEXT,
            head_sha TEXT,
            payload_json TEXT,
            created_at TEXT NOT NULL
        );
        """
    )
    try:
        conn.execute(
            "CREATE VIRTUAL TABLE IF NOT EXISTS session_fts USING fts5(session_id, agent, title, transcript_text);"
        )
    except Exception:
        pass
    conn.commit()
    return conn


def ensure_git_info_exclude(
    repo_path: Path,
    patterns: Tuple[str, ...] = (".agy-bridge/", "HANDOFF_CONTEXT.md"),
) -> None:
    """Adds local agy-bridge mirror files to .git/info/exclude so git status remains 100% clean."""
    try:
        rc, git_common_dir, _ = run_git(repo_path, ["rev-parse", "--git-common-dir"])
        if rc != 0 or not git_common_dir:
            return
        gdir = Path(git_common_dir)
        if not gdir.is_absolute():
            gdir = (repo_path / gdir).resolve()
        info_dir = gdir / "info"
        info_dir.mkdir(parents=True, exist_ok=True)
        excl = info_dir / "exclude"
        existing = excl.read_text(encoding="utf-8", errors="replace") if excl.exists() else ""
        lines = existing.splitlines()
        changed = False
        for pat in patterns:
            if pat not in lines:
                lines.append(pat)
                changed = True
        if changed:
            atomic_write_text(excl, "\n".join(lines).rstrip() + "\n")
    except Exception:
        pass


def ensure_git_repo(project_path: Path, init_commit: bool = True) -> bool:
    if is_non_project_dir(project_path):
        return False
    project_path.mkdir(parents=True, exist_ok=True)
    rc, _, _ = run_git(project_path, ["rev-parse", "--is-inside-work-tree"])
    created = False
    if rc != 0:
        run_git(project_path, ["init", "-q"])
        created = True
    ensure_git_info_exclude(project_path)
    if init_commit:
        rc_head, _, _ = run_git(project_path, ["rev-parse", "--verify", "HEAD"])
        if rc_head != 0:
            readme = project_path / "README.md"
            if not readme.exists():
                readme.write_text(f"# {project_path.name}\n\nInitialized by `agy-bridge`.\n", encoding="utf-8")
            stage_files = [f for f in ("README.md", "CLAUDE.md", "AGENTS.md") if (project_path / f).exists()]
            if stage_files:
                run_git(project_path, ["add", "--"] + stage_files)
            run_git(project_path, ["commit", "-q", "--allow-empty", "-m", "Initial commit via agy-bridge"])
    return created


def extract_project_uris(proj: Dict[str, Any]) -> List[str]:
    """Extracts all folder/gitFolder paths from an Antigravity project dict."""
    uris: List[str] = []
    resources = proj.get("projectResources", {}).get("resources", [])
    if not isinstance(resources, list):
        return uris
    for r in resources:
        if not isinstance(r, dict):
            continue
        gf = r.get("gitFolder") if isinstance(r.get("gitFolder"), dict) else {}
        raw_u = r.get("folderUri") or gf.get("folderUri") or gf.get("uri") or ""
        if raw_u:
            p_str = uri_to_path(raw_u)
            if p_str and p_str not in uris:
                uris.append(p_str)
    return uris


