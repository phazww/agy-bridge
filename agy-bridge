    base_repo, active_ws, all_git_paths = resolve_repo_and_worktree(raw_path)

    for gp in all_git_paths:
        if gp.exists():
            ensure_git_repo(gp, init_commit=True)

    proj_obj = register_or_update_agy_project(project_name, all_git_paths)
    project_id = proj_obj["id"]
    register_in_codex(all_git_paths)
    register_in_claude_presets(active_ws, project_name=project_name)

    matched_sessions, _, written_mirrors, written_handoffs, synced_docs = perform_three_layer_sync(
        project_name, base_repo, active_ws, all_git_paths, project_id, write_tracked_docs=write_docs
    )

    if not quiet:
        print(f"[agy-bridge] Synchronized 3-layer context for project '{project_name}' (Antigravity ID: {project_id})")
        print(f"  Base Repository  : {base_repo}")
        print(f"  Active Workspace : {active_ws}")
        print(f"  SQLite WAL Store : {get_git_common_bridge_dir(base_repo) / 'state.sqlite'}")
        print(f"  Matched Sessions : {len(matched_sessions)} across agents")
        print(f"  Session Mirrors  : {len(written_mirrors)} full mirror(s) in .agy-bridge/sessions/")
        print(f"  Handoff Context  : {', '.join(written_handoffs)}")
        print(f"  Git Status Clean : CLAUDE.md / AGENTS.md kept clean (state injected dynamically via hooks)")
    return 0


def cmd_hook_sync(args: argparse.Namespace) -> int:
    """
    Zero-Terminal lifecycle hook handler for both Claude Code/Desktop and Antigravity 2.0:
      - Handles `SessionStart`, `UserPromptSubmit`, `PreInvocation`, `PostToolUse`, `Stop`, and `StopFailure`.
      - Syncs state into `.git/agy-bridge/state.sqlite` + `.agy-bridge/LIVE_STATE.md` without dirtying `git status`.
      - Injects the ~350-token `LIVE_STATE.md` into the agent on `SessionStart` or when another agent updated the repo
        (delta cursor check so zero extra tokens are spent if nothing changed in other IDEs!).
      - On `StopFailure` (rate limit / API crash), logs the failure and triggers a macOS notification.
    """
    hook_input: Dict[str, Any] = {}
    try:
        if not sys.stdin.isatty():
            rlist, _, _ = select.select([sys.stdin], [], [], 0.15)
            if rlist:
                raw_in = sys.stdin.read()
                if raw_in and raw_in.strip():
                    hook_input = json.loads(raw_in.strip())
    except Exception:
        hook_input = {}

    is_agy = bool(getattr(args, "agy_hook", False) or "conversationId" in hook_input or "terminationReason" in hook_input or "invocationNum" in hook_input)
    event_name = getattr(args, "event", None) or hook_input.get("hook_event_name") or hook_input.get("hookEventName") or ""
    if not event_name:
        if "terminationReason" in hook_input:
            event_name = "Stop"
        elif "invocationNum" in hook_input:
            event_name = "PreInvocation"
        elif "toolCall" in hook_input or "tool_name" in hook_input:
            event_name = "PostToolUse"
        else:
            event_name = "Stop"

    ws_candidate: Optional[str] = getattr(args, "workspace", None)
    if not ws_candidate and isinstance(hook_input, dict):
        if hook_input.get("cwd"):
            ws_candidate = str(hook_input["cwd"])
        elif isinstance(hook_input.get("workspacePaths"), list) and hook_input["workspacePaths"]:
            ws_candidate = str(hook_input["workspacePaths"][0])

    if not ws_candidate:
        ws_candidate = str(Path.cwd())

    live_state_content = ""
    state_changed_for_reader = False
    try:
        p = Path(ws_candidate).expanduser().resolve()
        if not is_non_project_dir(p) and p.exists():
            base_repo, active_ws, _ = resolve_repo_and_worktree(p)
            bdir = get_git_common_bridge_dir(base_repo)
            live_file = bdir / "LIVE_STATE.md"
            reader_key = f"cursor_{'agy' if is_agy else 'claude'}.sha256"
            cursor_file = bdir / reader_key

            # Only run full 3-layer sync on write/stop events (PostToolUse, Stop, StopFailure),
            # or on SessionStart / PreInvocation / UserPromptSubmit if LIVE_STATE.md does not exist yet.
            # This makes PreInvocation / UserPromptSubmit instant (<5ms) and prevents an agent from
            # re-triggering state changes on its own read_file/tool steps!
            need_full_sync = event_name in ("PostToolUse", "Stop", "StopFailure", "SessionStart") or not live_file.exists()

            if need_full_sync:
                sync_ns = argparse.Namespace(target=str(p), workspace=str(p), quiet=True, write_docs=False)
                cmd_sync(sync_ns)

            if event_name == "StopFailure":
                sid = str(hook_input.get("session_id") or hook_input.get("conversationId") or "")
                record_repo_event(base_repo, "StopFailure", "agy" if is_agy else "claude", sid, str(active_ws), hook_input)
                notify_macos(
                    f"⚡️ agy-bridge: {base_repo.name}",
                    "Сессия прервана (лимит/ошибка). Контекст сохранён — можно продолжить в Antigravity/Codex!",
                )
                # Refresh LIVE_STATE.md so it includes the StopFailure banner
                sync_ns = argparse.Namespace(target=str(p), workspace=str(p), quiet=True, write_docs=False)
                cmd_sync(sync_ns)

            if live_file.exists():
                live_state_content = live_file.read_text(encoding="utf-8", errors="replace").strip()
                # Compute delta hash ignoring the timestamp line
                stable_lines = [
                    ln for ln in live_state_content.splitlines()
                    if not ln.startswith("- **Synced**:")
                ]
                cur_hash = hashlib.sha256("\n".join(stable_lines).encode("utf-8")).hexdigest()
                prev_hash = cursor_file.read_text(encoding="utf-8").strip() if cursor_file.exists() else ""

                if event_name in ("PostToolUse", "Stop"):
                    # The current agent just produced this state; advance its own cursor so it won't self-inject on next PreInvocation
                    atomic_write_text(cursor_file, cur_hash)
                elif event_name == "SessionStart" or cur_hash != prev_hash:
                    state_changed_for_reader = True
                    atomic_write_text(cursor_file, cur_hash)
    except Exception:
        pass

    # Output exact contract required by Antigravity 2.0 or Claude Code
    if is_agy:
        if event_name == "Stop":
            print(json.dumps({"decision": "allow"}))
        elif event_name in ("SessionStart", "PreInvocation") and live_state_content and state_changed_for_reader:
            print(json.dumps({
                "injectSteps": [
                    {"ephemeralMessage": live_state_content}
                ]
            }, ensure_ascii=False))
        else:
            print("{}")
    else:
        if event_name in ("SessionStart", "UserPromptSubmit") and live_state_content and state_changed_for_reader:
            print(json.dumps({
                "hookSpecificOutput": {
                    "hookEventName": event_name,
                    "additionalContext": live_state_content,
                }
            }, ensure_ascii=False))
        return 0
    return 0


def cmd_install_hooks(args: argparse.Namespace) -> int:
    """
    Installs Zero-Terminal automatic synchronization hooks, rules, and MCP servers across:
      1. `~/.claude/settings.json` (`SessionStart`, `UserPromptSubmit`, `PostToolUse`, `Stop`, `StopFailure` + `crossSessionInbound=accept`)
      2. `~/.gemini/config/plugins/agy-bridge/` (`plugin.json`, `hooks.json`, `mcp_config.json`, `rules/AGENTS.md`)
      3. `~/.gemini/config/mcp_config.json` & `~/.claude.json` & `~/.codex/config.toml` (MCP server `agy_bridge`)
      4. Short CLI alias `~/.local/bin/ab` -> `agy-bridge`
    """
    agy_bridge_bin = str(HOME / ".local" / "bin" / "agy-bridge")
    ab_alias = HOME / ".local" / "bin" / "ab"
    try:
        if ab_alias.exists() or ab_alias.is_symlink():
            ab_alias.unlink()
        ab_alias.symlink_to(agy_bridge_bin)
    except Exception:
        pass

    # 1. Configure ~/.claude/settings.json
    CLAUDE_DIR.mkdir(parents=True, exist_ok=True)
    claude_settings: Dict[str, Any] = {}
    if CLAUDE_SETTINGS_FILE.exists():
        try:
            claude_settings = json.loads(CLAUDE_SETTINGS_FILE.read_text(encoding="utf-8"))
        except Exception:
            claude_settings = {}

    claude_settings["crossSessionInbound"] = "accept"
    hooks_obj = claude_settings.setdefault("hooks", {})
    if not isinstance(hooks_obj, dict):
        hooks_obj = {}
        claude_settings["hooks"] = hooks_obj

    def _set_claude_hook(ev: str, cmd_args: List[str], is_async: bool = True, matcher: Optional[str] = None) -> None:
        existing = hooks_obj.get(ev, [])
        if not isinstance(existing, list):
            existing = []
        cleaned = [e for e in existing if "agy-bridge" not in json.dumps(e)]
        entry: Dict[str, Any] = {
            "hooks": [
