def perform_three_layer_sync(
    project_name: str,
    base_repo: Path,
    active_ws: Path,
    all_git_paths: List[Path],
    project_id: str,
    primary_parsed: Optional[Dict[str, Any]] = None,
    write_tracked_docs: bool = False,
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]], List[str], List[str], List[str]]:
    """
    Executes the full 3-layer Full-Fidelity Context Sync under an exclusive repo flock:
      - Canonical Store: SQLite WAL (`<git-common-dir>/agy-bridge/state.sqlite`) with FTS5 + decisions + events
      - Layer 3: 100% unabridged, secret-redacted session mirrors in `.agy-bridge/sessions/<agent>_<id>.md`
      - Layer 2: Multi-agent `HANDOFF_CONTEXT.md` (git-ignored via `.git/info/exclude`)
      - Layer 1: Token-lean `LIVE_STATE.md` in `.agy-bridge/LIVE_STATE.md` & `<git-common-dir>/agy-bridge/LIVE_STATE.md`
                 (injected dynamically via hooks without dirtying tracked `CLAUDE.md`/`AGENTS.md` unless `write_tracked_docs=True`).
    """
    with with_repo_lock(base_repo):
        matched_sessions, all_parsed_sessions, best_parsed = discover_project_sessions(project_name, project_id, all_git_paths)

        if primary_parsed is not None and primary_parsed.get("sessionId"):
            p_sid = primary_parsed["sessionId"]
            all_parsed_sessions = [primary_parsed] + [s for s in all_parsed_sessions if s.get("sessionId") != p_sid]
            best_parsed = primary_parsed

        if best_parsed is None:
            best_parsed = {
                "agent": "sync",
                "sessionId": "none",
                "title": f"Synchronized state for {project_name}",
                "sourcePath": str(active_ws),
                "cwd": str(active_ws),
                "branch": "",
                "mtime": time.time(),
                "lastModified": now_iso(),
                "initialUserGoal": "",
                "totalTurns": 0,
                "allTurns": [],
                "turns": [],
                "modifiedFiles": [],
                "readFiles": [],
                "touchedFiles": [],
            }

        # Persist to shared SQLite WAL + FTS5 in <git-common-dir>/agy-bridge/state.sqlite
        persist_sessions_to_sqlite(base_repo, all_parsed_sessions)

        # Clean any legacy AUTO-STATE blocks from tracked CLAUDE.md/AGENTS.md and set .git/info/exclude BEFORE git status snapshot
        if not write_tracked_docs:
            sync_claude_and_agents_md(all_git_paths, project_name, auto_state_block=None, write_tracked_docs=False)

        # Layer 3: Write 100% unabridged session mirrors to .agy-bridge/sessions/
        written_mirrors = write_full_session_mirrors(all_git_paths, project_name, all_parsed_sessions)

        # Layer 2: Write multi-agent HANDOFF_CONTEXT.md (secret-redacted & excluded from git status)
        md = redact_secrets(
            generate_handoff_markdown(
                project_name,
                base_repo,
                active_ws,
                project_id,
                best_parsed,
                extra_sessions=matched_sessions,
                all_parsed_sessions=all_parsed_sessions,
            )
        )
        written_handoffs: List[str] = []
        for gp in all_git_paths:
            if gp.exists() and not is_non_project_dir(gp):
                ensure_git_info_exclude(gp, (".agy-bridge/", "HANDOFF_CONTEXT.md"))
                hf = gp / "HANDOFF_CONTEXT.md"
                atomic_write_text(hf, md, mode=0o600)
                written_handoffs.append(str(hf))

        # Layer 1: Build ~350-token Progress State block
        human_doc_bytes = 1200
        for gp in all_git_paths:
            for fn in ("CLAUDE.md", "AGENTS.md"):
                f = gp / fn
                if f.exists():
                    clean_h = strip_auto_state_block(f.read_text(encoding="utf-8", errors="replace"))
                    human_doc_bytes = max(human_doc_bytes, len(clean_h.encode("utf-8")))
        auto_budget = max(4500, min(16000, AGY_RULE_MAX_BYTES - human_doc_bytes))
        auto_block = build_auto_state_block(
            project_name,
            active_ws,
            project_id,
            all_parsed_sessions,
            matched_sessions,
            max_budget_bytes=auto_budget,
        )
        synced_docs = sync_claude_and_agents_md(
            all_git_paths,
            project_name,
            auto_state_block=auto_block,
            write_tracked_docs=write_tracked_docs,
        )
        return matched_sessions, all_parsed_sessions, written_mirrors, written_handoffs, synced_docs


