def cmd_spawn_claude(args: argparse.Namespace) -> int:
    ws_input = args.workspace or args.path_or_name or str(Path.cwd())
    prompt = args.prompt or args.positional_prompt
    raw_path, inferred_name = resolve_project_input(ws_input)
    project_name = args.name or inferred_name

    ensure_git_repo(raw_path, init_commit=True)
    base_repo, active_ws, all_git_paths = resolve_repo_and_worktree(raw_path)
    for gp in all_git_paths:
        if gp.exists():
            ensure_git_repo(gp, init_commit=True)

    proj_obj = register_or_update_agy_project(project_name, all_git_paths)
    project_id = proj_obj["id"]
    register_in_claude_presets(active_ws, project_name=project_name)
    register_in_codex(all_git_paths)

    perform_three_layer_sync(project_name, base_repo, active_ws, all_git_paths, project_id)

    claude_exe = str(CLAUDE_BIN) if CLAUDE_BIN.exists() else (shutil.which("claude") or "")
    launch_result: Dict[str, Any] = {"mode": "register-only", "returnCode": 0, "output": ""}

    if not args.register_only and claude_exe:
        if args.desktop:
            cmd = [claude_exe, "--desktop"]
            if prompt:
                cmd.append(prompt)
            proc = subprocess.Popen(cmd, cwd=str(active_ws), stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            try:
                out, err = proc.communicate(timeout=8)
                launch_result = {"mode": "desktop", "returnCode": proc.returncode, "output": (out + "\n" + err).strip()}
            except subprocess.TimeoutExpired:
                launch_result = {"mode": "desktop", "returnCode": 0, "output": "Launched in Claude Desktop"}
        elif args.bg and prompt:
            cmd = [claude_exe, "--bg", "--permission-mode", "bypassPermissions", prompt]
            proc = subprocess.Popen(cmd, cwd=str(active_ws), stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            try:
                out, err = proc.communicate(timeout=10)
                launch_result = {"mode": "bg", "returnCode": proc.returncode, "output": (out + "\n" + err).strip()}
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.communicate()
                launch_result = {"mode": "bg", "returnCode": 124, "output": "Timed out starting bg session"}
        elif prompt and args.print_mode:
            cmd = [claude_exe, "-p", prompt, "--permission-mode", "bypassPermissions"]
            if args.model:
                cmd.extend(["--model", args.model])
            proc = subprocess.Popen(cmd, cwd=str(active_ws), stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            try:
                out, err = proc.communicate(timeout=args.timeout)
                launch_result = {"mode": "print", "returnCode": proc.returncode, "output": out.strip(), "error": err.strip()}
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.communicate()
                launch_result = {"mode": "print", "returnCode": 124, "output": "", "error": f"Timed out after {args.timeout}s (process cleaned up)"}

    print(f"[agy-bridge] Project '{project_name}' prepared for Claude Code / Desktop & synced with Antigravity ({project_id})")
    print(f"  Workspace : {active_ws}")
    print(f"  Mode      : {launch_result['mode']}")
    if launch_result.get("output"):
        print(f"  Output    : {launch_result['output'][:400]}")
    return 0


