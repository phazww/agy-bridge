def register_in_codex(paths: List[Path]) -> bool:
    """Registers project path(s) in ~/.codex/.codex-global-state.json and ~/.codex/state_5.sqlite."""
    updated = False
    resolved_strs = [str(p.expanduser().resolve()) for p in paths if p.exists()]
    if not resolved_strs:
        return False

    if CODEX_DIR.exists():
        state_data: Dict[str, Any] = {}
        if CODEX_GLOBAL_STATE.exists():
            try:
                state_data = json.loads(CODEX_GLOBAL_STATE.read_text(encoding="utf-8"))
            except Exception:
                state_data = {}
        for key in ("active-workspace-roots", "electron-saved-workspace-roots"):
            arr = state_data.get(key, [])
            if not isinstance(arr, list):
                arr = []
            for p_str in resolved_strs:
                if p_str not in arr:
                    arr.insert(0, p_str)
                    updated = True
            state_data[key] = arr
        if updated or not CODEX_GLOBAL_STATE.exists():
            CODEX_GLOBAL_STATE.write_text(json.dumps(state_data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
            updated = True

    if CODEX_SQLITE.exists():
        try:
            conn = sqlite3.connect(str(CODEX_SQLITE))
            cur = conn.cursor()
            now_ts = int(time.time())
            for p_str in resolved_strs:
                p_name = Path(p_str).name
                cur.execute("SELECT id FROM project_roots WHERE root_path = ?", (p_str,))
                row = cur.fetchone()
                if not row:
                    pid = str(uuid.uuid4())
                    cur.execute(
                        "INSERT OR IGNORE INTO projects (id, name, created_at, updated_at, last_Selected_at) VALUES (?, ?, ?, ?, ?)",
                        (pid, p_name, now_ts, now_ts, now_ts),
                    )
                    cur.execute(
                        "INSERT OR IGNORE INTO project_roots (id, root_path) VALUES (?, ?)",
                        (pid, p_str),
                    )
                    updated = True
            conn.commit()
            conn.close()
        except Exception:
            pass
    return updated


def list_codex_sessions(limit: int = 10) -> Dict[str, Any]:
    workspaces: List[str] = []
    if CODEX_GLOBAL_STATE.exists():
        try:
            st = json.loads(CODEX_GLOBAL_STATE.read_text(encoding="utf-8"))
            workspaces = st.get("active-workspace-roots", [])
        except Exception:
            pass

    threads: List[Dict[str, Any]] = []
    if CODEX_SQLITE.exists():
        try:
            conn = sqlite3.connect(str(CODEX_SQLITE))
            conn.row_factory = sqlite3.Row
            cur = conn.cursor()
            cur.execute(
                "SELECT id, title, cwd, git_branch, updated_at, rollout_path FROM threads WHERE archived = 0 ORDER BY updated_at DESC LIMIT ?",
                (limit,),
            )
            for r in cur.fetchall():
                threads.append({
                    "id": r["id"],
                    "title": (r["title"] or "").strip().replace("\n", " ")[:100],
                    "cwd": r["cwd"],
                    "gitBranch": r["git_branch"] or "",
                    "updatedAt": ts_to_iso(r["updated_at"]),
                    "rolloutPath": r["rollout_path"],
                })
            conn.close()
        except Exception:
            pass
    return {"workspaces": workspaces, "threads": threads}


