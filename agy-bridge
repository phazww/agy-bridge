def handle_mcp_tool_call(name: str, arguments: Dict[str, Any]) -> Dict[str, Any]:
    proj_arg = arguments.get("project")
    raw_path = resolve_project_input(proj_arg)[0] if proj_arg else find_most_recent_active_project()
    base_repo, active_ws, all_git_paths = resolve_repo_and_worktree(raw_path)

    if name == "bridge_get_state":
        proj_obj = register_or_update_agy_project(base_repo.name, all_git_paths)
        perform_three_layer_sync(base_repo.name, base_repo, active_ws, all_git_paths, proj_obj["id"], write_tracked_docs=False)
        live_file = active_ws / ".agy-bridge" / "LIVE_STATE.md"
        txt = live_file.read_text(encoding="utf-8", errors="replace") if live_file.exists() else "No state found."
        return {"content": [{"type": "text", "text": txt}]}

    if name == "bridge_continue_task":
        to_ag = arguments.get("to_agent") or "current"
        spawn_flag = to_ag.lower() not in ("current", "here", "none", "self")
        res = execute_continue_failover(
            target_project=str(active_ws),
            to_agent=None if not spawn_flag else to_ag,
            custom_prompt=arguments.get("prompt"),
            focus=True,
            spawn=spawn_flag,
        )
        return {"content": [{"type": "text", "text": json.dumps(res, indent=2, ensure_ascii=False)}]}

    if name == "bridge_send_to_claude":
        rc, info, err = send_claude_socket_message(str(arguments.get("target", active_ws)), str(arguments.get("message", "")))
        return {"content": [{"type": "text", "text": json.dumps({"returnCode": rc, "target": info, "error": err}, indent=2, ensure_ascii=False)}]}

    if name == "bridge_spawn_agy_chat":
        ns = argparse.Namespace(
            path_or_name=arguments.get("project"),
            positional_prompt=arguments.get("prompt"),
            workspace=None,
            name=None,
            prompt=arguments.get("prompt"),
            title=None,
            model=None,
            project_id=None,
            from_claude=None,
            focus=True,
            no_chat=False,
            timeout=30,
            json=True,
        )
        res = execute_continue_failover(
            target_project=arguments.get("project"),
            to_agent="agy",
            custom_prompt=arguments.get("prompt"),
            focus=True,
            spawn=True,
        )
        return {"content": [{"type": "text", "text": json.dumps(res, indent=2, ensure_ascii=False)}]}

    if name == "bridge_record_decision":
        rec = record_repo_decision(
            base_repo,
            summary=str(arguments.get("summary", "")),
            reason=str(arguments.get("reason", "")),
            kind=str(arguments.get("kind", "decision")),
            agent="mcp",
        )
        return {"content": [{"type": "text", "text": json.dumps(rec, indent=2, ensure_ascii=False)}]}

    if name == "bridge_search_history":
        hits = search_repo_history_fts(base_repo, str(arguments.get("query", "")))
        return {"content": [{"type": "text", "text": json.dumps(hits, indent=2, ensure_ascii=False)}]}

    return {"isError": True, "content": [{"type": "text", "text": f"Unknown tool: {name}"}]}


def cmd_mcp(args: argparse.Namespace) -> int:
    """Runs the standard JSON-RPC 2.0 MCP server over stdio."""
    while True:
        line = sys.stdin.readline()
        if not line:
            break
        line_str = line.strip()
        if not line_str:
            continue
        if line_str.lower().startswith("content-length:"):
            length = int(line_str.split(":", 1)[1].strip())
            while True:
                hdr = sys.stdin.readline()
                if not hdr or not hdr.strip():
                    break
            body = sys.stdin.read(length)
            try:
                req = json.loads(body)
            except Exception:
                continue
            use_framing = True
        else:
            try:
                req = json.loads(line_str)
            except Exception:
                continue
            use_framing = False

        method = req.get("method", "")
        req_id = req.get("id")
        resp_obj: Optional[Dict[str, Any]] = None

        if method == "initialize":
            client_proto = (req.get("params") or {}).get("protocolVersion") or "2024-11-05"
            resp_obj = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": client_proto,
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "agy-bridge-mcp", "version": "0.3.0"},
                },
            }
        elif method == "notifications/initialized":
            resp_obj = None
        elif method == "ping":
            resp_obj = {"jsonrpc": "2.0", "id": req_id, "result": {}}
        elif method == "tools/list":
            resp_obj = {"jsonrpc": "2.0", "id": req_id, "result": {"tools": MCP_TOOLS_SCHEMA}}
        elif method == "tools/call":
            params = req.get("params") or {}
            tname = params.get("name", "")
            targs = params.get("arguments") or {}
            try:
                tool_res = handle_mcp_tool_call(tname, targs)
                resp_obj = {"jsonrpc": "2.0", "id": req_id, "result": tool_res}
            except Exception as exc:
                resp_obj = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {"isError": True, "content": [{"type": "text", "text": str(exc)}]},
                }
        elif req_id is not None:
            resp_obj = {"jsonrpc": "2.0", "id": req_id, "result": {}}

        if resp_obj is not None:
            out_str = json.dumps(resp_obj, ensure_ascii=False)
            if use_framing:
                out_bytes = out_str.encode("utf-8")
                sys.stdout.write(f"Content-Length: {len(out_bytes)}\r\n\r\n{out_str}")
            else:
                sys.stdout.write(out_str + "\n")
            sys.stdout.flush()
    return 0


def cmd_focus(args: argparse.Namespace) -> int:
    cid, pid, _ = resolve_cascade_target(args.target)
    target_cid = cid or (args.target if is_uuid(args.target) else "")
    ok, resp = focus_agy_conversation(target_cid, project_id=pid)
    if ok:
        print(f"[agy-bridge] Focused Antigravity conversation: {target_cid or pid} ({resp.get('method', 'rpc')})")
        return 0
    print(f"[agy-bridge] Failed to focus conversation '{args.target}': {resp}", file=sys.stderr)
    return 1


