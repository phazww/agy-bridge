def list_live_claude_sockets() -> List[Dict[str, Any]]:
    """
    Discovers live Claude Desktop / CLI sessions listening on /tmp/cc-socks/<pid>.sock
    via ~/.claude/sessions/<pid>.json and extracts their peerToken from <pid>.<sha256>.key.
    """
    live: List[Dict[str, Any]] = []
    if not CLAUDE_LIVE_SESSIONS_DIR.exists():
        return live

    for sf in sorted(CLAUDE_LIVE_SESSIONS_DIR.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True):
        try:
            data = json.loads(sf.read_text(encoding="utf-8"))
            pid = int(data.get("pid") or 0)
            sock_path = data.get("messagingSocketPath") or f"/tmp/cc-socks/{pid}.sock"
            if not pid or not Path(sock_path).exists():
                continue
            try:
                os.kill(pid, 0)
            except OSError:
                continue

            peer_token = ""
            try:
                resolved_sock = str(Path(sock_path).resolve())
                sock_hash = hashlib.sha256(resolved_sock.encode("utf-8")).hexdigest()
                exact_key = CLAUDE_LIVE_SESSIONS_DIR / f"{pid}.{sock_hash}.key"
                key_candidates = [exact_key] if exact_key.exists() else list(CLAUDE_LIVE_SESSIONS_DIR.glob(f"{pid}.*.key"))
                for kf in key_candidates:
                    if kf.exists():
                        kdata = json.loads(kf.read_text(encoding="utf-8"))
                        if kdata.get("peerToken"):
                            peer_token = kdata["peerToken"]
                            break
            except Exception:
                pass

            live.append({
                "pid": pid,
                "sessionId": data.get("sessionId", ""),
                "hostSessionId": data.get("hostSessionId", ""),
                "name": data.get("name", ""),
                "cwd": data.get("cwd", ""),
                "entrypoint": data.get("entrypoint", ""),
                "status": data.get("status", ""),
                "socketPath": sock_path,
                "hasPeerToken": bool(peer_token),
                "peerToken": peer_token,
                "updatedAt": ts_to_iso(data.get("updatedAt") or sf.stat().st_mtime),
            })
        except Exception:
            continue
    return live


def resolve_live_claude_socket(target: str) -> Optional[Dict[str, Any]]:
    """Matches a live Claude socket session by PID, sessionId, hostSessionId, title, project name, or cwd."""
    sockets = list_live_claude_sockets()
    if not sockets:
        return None
    needle = target.strip()
    needle_lower = needle.lower()

    for s in sockets:
        if (
            str(s["pid"]) == needle
            or s["sessionId"] == needle
            or s["hostSessionId"] == needle
            or s["socketPath"] == needle
        ):
            return s

    try:
        expanded = Path(needle).expanduser()
        if expanded.exists():
            base_repo, active_ws, all_paths = resolve_repo_and_worktree(expanded)
            path_strs = [str(p.resolve()) for p in all_paths]
            for s in sockets:
                if s["cwd"] and any(ps == str(Path(s["cwd"]).resolve()) for ps in path_strs):
                    return s
    except Exception:
        pass

    for s in sockets:
        if needle_lower in (s.get("name") or "").lower() or needle_lower in (s.get("cwd") or "").lower():
            return s

    return None


def send_claude_socket_message(
    target: str,
    message: str,
    priority: str = "next",
    timeout: float = 5.0,
) -> Tuple[int, Dict[str, Any], str]:
    """
    Sends a user message directly into an open Claude Desktop / CLI session over its Unix domain socket
    (/tmp/cc-socks/<pid>.sock) using the peerToken from ~/.claude/sessions/<pid>.<sha256>.key.
    """
    sock_info = resolve_live_claude_socket(target)
    if not sock_info:
        return 1, {}, f"No live Claude socket found matching '{target}'"

    sock_path = sock_info["socketPath"]
    peer_token = sock_info.get("peerToken", "")
    session_id = sock_info.get("sessionId", "")
    msg_uuid = str(uuid.uuid4())

    frames: List[str] = []
    if peer_token:
        frames.append(json.dumps({"type": "auth", "token": peer_token}, ensure_ascii=False))
    user_frame: Dict[str, Any] = {
        "type": "user",
        "uuid": msg_uuid,
        "msg_id": msg_uuid,
        "priority": priority if priority in ("now", "next", "later") else "next",
        "from": "agy-bridge",
        "from_mode": "bypass",
        "message": {
            "role": "user",
            "content": message,
        },
    }
    if session_id:
        user_frame["session_id"] = session_id
    frames.append(json.dumps(user_frame, ensure_ascii=False))
    payload_bytes = ("\n".join(frames) + "\n").encode("utf-8")

    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(sock_path)
        s.sendall(payload_bytes)
        s.shutdown(socket.SHUT_WR)
        try:
            s.settimeout(0.4)
            _ = s.recv(4096)
        except Exception:
            pass
        return 0, {
            "pid": sock_info["pid"],
            "sessionId": session_id,
            "hostSessionId": sock_info.get("hostSessionId", ""),
            "name": sock_info.get("name", ""),
            "cwd": sock_info.get("cwd", ""),
            "socketPath": sock_path,
            "uuid": msg_uuid,
            "authenticated": bool(peer_token),
        }, ""
    except Exception as exc:
        return 1, sock_info, str(exc)
    finally:
        try:
            s.close()
        except Exception:
            pass


