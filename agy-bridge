def cmd_uninstall(args: argparse.Namespace) -> int:
    """Cleanly removes agy-bridge hooks and MCP entries from global configs."""
    if CLAUDE_SETTINGS_FILE.exists():
        try:
            cs = json.loads(CLAUDE_SETTINGS_FILE.read_text(encoding="utf-8"))
            hooks_obj = cs.get("hooks", {})
            if isinstance(hooks_obj, dict):
                for k in list(hooks_obj.keys()):
                    if isinstance(hooks_obj[k], list):
                        hooks_obj[k] = [e for e in hooks_obj[k] if "agy-bridge" not in json.dumps(e)]
                        if not hooks_obj[k]:
                            del hooks_obj[k]
            atomic_write_text(CLAUDE_SETTINGS_FILE, json.dumps(cs, indent=2, ensure_ascii=False) + "\n")
        except Exception:
            pass

    plugin_dir = AGY_PLUGINS_DIR / "agy-bridge"
    if plugin_dir.exists():
        shutil.rmtree(plugin_dir, ignore_errors=True)

    print("[agy-bridge] Cleanly uninstalled global hooks and plugin.")
    return 0


