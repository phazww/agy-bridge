def resolve_cascade_target(target: str) -> Tuple[Optional[str], Optional[str], Optional[Path]]:
    """
    Resolves a target string (cascade_id UUID, project UUID, project name, or workspace path)
    to (cascade_id, project_id, workspace_path).
    """
    all_convs = list_agy_conversations(top_level_only=False)
    for c in all_convs:
        if c["cascadeId"] == target:
            w_uris = c.get("workspaceUris", [])
            w_path = Path(uri_to_path(w_uris[0])) if w_uris else None
            return c["cascadeId"], c.get("projectId") or None, w_path

    for proj in list_agy_projects():
        pid = proj.get("id", "")
        pname = proj.get("name", "")
        uris = extract_project_uris(proj)
        matched = False
        if target == pid or target.lower() == pname.lower():
            matched = True
        else:
            try:
                t_res = str(Path(target).expanduser().resolve())
                if t_res in uris:
                    matched = True
            except Exception:
                pass
        if matched:
            w_path = Path(uris[0]) if uris else None
            proj_convs = list_agy_conversations(project_id=pid, workspace_path=w_path, top_level_only=True)
            if proj_convs:
                return proj_convs[0]["cascadeId"], pid, w_path
            return None, pid, w_path

    if is_uuid(target):
        return target, None, None
    return None, None, None


def cmd_send_agy(args: argparse.Namespace) -> int:
    cascade_id, project_id, ws_path = resolve_cascade_target(args.target)
    if not cascade_id:
        print(f"[agy-bridge] Error: Could not resolve an existing Antigravity conversation for '{args.target}'.", file=sys.stderr)
        print("  Tip: Use `agy-bridge spawn-agy <project> \"<message>\"` to start the first conversation in this project.", file=sys.stderr)
        return 1

    rc, out, err = send_agy_cascade_message(cascade_id, args.message, timeout=args.timeout)
    focused = False
    if args.focus:
        focused, _ = focus_agy_conversation(cascade_id, project_id=project_id)

    if getattr(args, "json", False):
        print(json.dumps({
            "returnCode": rc,
            "cascadeId": cascade_id,
            "projectId": project_id,
            "response": out,
            "error": err,
            "focused": focused,
        }, indent=2, ensure_ascii=False))
    else:
        print(f"[agy-bridge] Sent message to cascade_id={cascade_id} (project_id={project_id or 'auto'}, rc={rc})")
        if err:
            print(f"  stderr: {err}")
        if focused:
            print("  UI Focus: Focused in Antigravity window")
    return 0 if rc == 0 else rc


