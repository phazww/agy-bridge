                "allTurns": [],
                "turns": [],
                "modifiedFiles": [],
                "readFiles": [],
                "touchedFiles": [],
            }
        else:
            print(f"[agy-bridge] Error: Could not find Claude session matching '{from_claude_val}'", file=sys.stderr)
            return 1

    elif from_agy_val:
        cid, pid, w_path = resolve_cascade_target(from_agy_val)
        target_cid = cid or from_agy_val
        parsed = parse_agy_session(target_cid, max_turns=max_turns)
        if w_path and w_path.exists():
            inferred_ws = w_path
        elif parsed.get("cwd") and Path(parsed["cwd"]).exists():
            inferred_ws = Path(parsed["cwd"])

    elif from_wb_val:
        wb_sessions = list_workbuddy_sessions(limit=50)
        matched_wb = None
        for wb in wb_sessions:
            if from_wb_val in (wb["sessionId"], wb["projectSlug"]) or from_wb_val.lower() in wb["cwd"].lower():
                matched_wb = wb
                break
        if not matched_wb:
            print(f"[agy-bridge] Error: Could not find WorkBuddy session matching '{from_wb_val}'", file=sys.stderr)
            return 1
        parsed = parse_claude_or_workbuddy_jsonl(Path(matched_wb["jsonlPath"]), max_turns=max_turns)
        if parsed.get("cwd") and Path(parsed["cwd"]).exists():
            inferred_ws = Path(parsed["cwd"])

    elif from_codex_val:
        codex_info = list_codex_sessions(limit=50)
        matched_th = None
        for th in codex_info["threads"]:
            if from_codex_val == th["id"] or from_codex_val.lower() in th["cwd"].lower():
                matched_th = th
                break
        if not matched_th or not matched_th.get("rolloutPath"):
            print(f"[agy-bridge] Error: Could not find Codex thread matching '{from_codex_val}'", file=sys.stderr)
            return 1
        parsed = parse_codex_jsonl(Path(matched_th["rolloutPath"]), max_turns=max_turns)
        if matched_th.get("cwd") and Path(matched_th["cwd"]).exists():
            inferred_ws = Path(matched_th["cwd"])

    else:
        return cmd_sync(args)

    ws_override = args.workspace or pos_target
    ws_target = Path(ws_override).expanduser().resolve() if (ws_override and Path(ws_override).expanduser().exists()) else (inferred_ws or Path.cwd().resolve())
    base_repo, active_ws, all_git_paths = resolve_repo_and_worktree(ws_target)
    project_name = args.name or base_repo.name

    for gp in all_git_paths:
        if gp.exists():
            ensure_git_repo(gp, init_commit=True)

    proj_obj = register_or_update_agy_project(project_name, all_git_paths)
    project_id = proj_obj["id"]
    register_in_codex(all_git_paths)
    register_in_claude_presets(active_ws, project_name=project_name)

    _, _, written_mirrors, written_handoffs, synced_docs = perform_three_layer_sync(
        project_name, base_repo, active_ws, all_git_paths, project_id, primary_parsed=parsed
    )

    exported_jsonl: Optional[Path] = None
    if args.to_claude and parsed.get("agent") != "claude":
        exported_jsonl = export_to_claude_jsonl(parsed, active_ws)

    spawned_conv: Optional[Dict[str, Any]] = None
    if args.to_agy and not args.no_chat:
        handoff_prompt = args.prompt or (
            f"Сессия перенесена из {parsed.get('agent', 'Claude')} (ID: {parsed.get('sessionId')}). "
            f"Прочитай файл HANDOFF_CONTEXT.md, авто-блок в CLAUDE.md и полные зеркала в .agy-bridge/sessions/ в рабочей папке ({active_ws}) и продолжи выполнение задачи."
        )
        rc, cid, out, err = start_agy_cascade(project_id, handoff_prompt, timeout=30)
        if not cid:
            convs = list_agy_conversations(project_id=project_id, workspace_path=active_ws)
            if convs:
                cid = convs[0]["cascadeId"]
        if args.focus and cid:
            focus_agy_conversation(cid, project_id=project_id)
        spawned_conv = {"returnCode": rc, "cascadeId": cid, "error": err}

    print(f"[agy-bridge] Full-Fidelity Handoff complete for project '{project_name}' (Antigravity ID: {project_id})")
    print(f"  Source Session   : [{parsed.get('agent')}] {parsed.get('sessionId')} ({parsed.get('totalTurns', 0)} turns captured unabridged)")
    if parsed.get("title"):
        print(f"  Session Title    : {parsed.get('title')}")
    print(f"  Active Workspace : {active_ws}")
    if base_repo != active_ws:
        print(f"  Base Repository  : {base_repo}")
    print(f"  Handoff Files    : {', '.join(written_handoffs)}")
    print(f"  Session Mirrors  : {len(written_mirrors)} full mirror(s) in .agy-bridge/sessions/")
    if synced_docs:
        print(f"  Synced Docs      : {', '.join(synced_docs)}")
    if exported_jsonl:
        print(f"  Claude JSONL     : {exported_jsonl}")
    if spawned_conv:
        print(f"  Spawned AGY Chat : cascade_id={spawned_conv.get('cascadeId')} (rc={spawned_conv['returnCode']})")
    return 0


def notify_macos(title: str, message: str) -> None:
    """Shows a non-blocking native macOS notification banner."""
    try:
        safe_t = title.replace('"', '\\"').replace("'", "’")[:80]
        safe_m = message.replace('"', '\\"').replace("'", "’")[:200]
        subprocess.Popen(
            ["/usr/bin/osascript", "-e", f'display notification "{safe_m}" with title "{safe_t}"'],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def find_most_recent_active_project() -> Path:
    """Finds the most recently active project directory across Claude, Antigravity, Codex, and WorkBuddy."""
    cwd = Path.cwd().resolve()
    if not is_non_project_dir(cwd) and (cwd / ".git").exists():
        return cwd

    candidates: List[Tuple[float, Path]] = []
    for cs in list_claude_sessions(limit=15):
        for p_str in (cs.get("worktreePath"), cs.get("cwd")):
            if p_str:
                p = Path(p_str)
                if p.exists() and not is_non_project_dir(p):
                    candidates.append((float(cs.get("mtime") or 0), p))

    for ac in list_agy_conversations()[:10]:
        for u in ac.get("workspaceUris") or []:
            p_str = uri_to_path(u)
            if p_str:
                p = Path(p_str)
                if p.exists() and not is_non_project_dir(p):
                    candidates.append((iso_to_epoch(ac.get("lastModifiedTime", "")), p))

    if candidates:
        candidates.sort(key=lambda x: x[0], reverse=True)
        return candidates[0][1]
    return DEFAULT_DOCS_DIR / "agy-bridge"


def execute_continue_failover(
    target_project: Optional[str] = None,
    to_agent: Optional[str] = None,
    custom_prompt: Optional[str] = None,
    focus: bool = True,
    spawn: bool = True,
) -> Dict[str, Any]:
    """
    Core 1-step failover engine (`agy-bridge continue` / `switch` / MCP `bridge_continue_task`):
      1. Resolves the target project (or auto-discovers the most recently active project on macOS)
      2. Syncs all sessions and finds the latest session (e.g. an interrupted Claude session)
      3. Chooses the target IDE automatically if not specified (e.g. Claude -> Antigravity, Antigravity -> Claude)
      4. Builds a crisp recovery prompt (`Goal` + `Last Prompt` + `Last Outcome` + `Modified Files` + `HEAD`)
      5. Spawns or messages the target agent and returns the structured recovery bundle.
    """
    if target_project:
        raw_path, project_name = resolve_project_input(target_project)
    else:
        raw_path = find_most_recent_active_project()
        project_name = raw_path.name

    base_repo, active_ws, all_git_paths = resolve_repo_and_worktree(raw_path)
    project_name = base_repo.name

    for gp in all_git_paths:
        if gp.exists():
            ensure_git_repo(gp, init_commit=True)

    proj_obj = register_or_update_agy_project(project_name, all_git_paths)
    project_id = proj_obj["id"]
    register_in_codex(all_git_paths)
    register_in_claude_presets(active_ws, project_name=project_name)

    matched_sessions, all_parsed, written_mirrors, written_handoffs, _ = perform_three_layer_sync(
        project_name, base_repo, active_ws, all_git_paths, project_id, write_tracked_docs=False
    )

    latest_session = all_parsed[0] if all_parsed else None
    source_agent = (latest_session or {}).get("agent", "claude")
    source_sid = (latest_session or {}).get("sessionId", "none")

    if not to_agent or to_agent == "auto":
        to_agent = "agy" if source_agent != "antigravity" else "claude"
    to_agent_norm = to_agent.lower().strip()
    if to_agent_norm in ("antigravity", "agy"):
        to_agent_norm = "agy"
    elif to_agent_norm in ("claude", "claude-code", "claude-desktop"):
        to_agent_norm = "claude"
    elif to_agent_norm in ("codex", "openai"):
        to_agent_norm = "codex"

    all_turns = (latest_session or {}).get("allTurns") or []
    init_goal = extract_clean_progress_text((latest_session or {}).get("initialUserGoal") or "", max_chars=350)
    last_user = ""
    last_assistant = ""
    for t in reversed(all_turns):
        if not last_assistant and t.get("role") == "assistant":
            cand = extract_clean_progress_text(t.get("text") or "", max_chars=500)
            if cand and not cand.startswith("*(Executed tools:"):
                last_assistant = cand
        elif not last_user and t.get("role") == "user":
            last_user = extract_clean_progress_text(t.get("text") or "", max_chars=350)
        if last_user and last_assistant:
            break

    mfiles = (latest_session or {}).get("modifiedFiles") or []
    _, status_out, _ = run_git(active_ws, ["status", "-s"])
    _, head_sha, _ = run_git(active_ws, ["rev-parse", "--short", "HEAD"])

    recovery_prompt = custom_prompt or (
        f"Перехват задачи из `{source_agent}` (сессия `{source_sid[:8]}`, проект `{project_name}`, `HEAD={head_sha}`).\n"
        f"- **Исходная цель**: {init_goal or '(см. HANDOFF_CONTEXT.md)'}\n"
        f"- **Последний запрос пользователя**: {last_user or '(см. HANDOFF_CONTEXT.md)'}\n"
        f"- **На чём остановился предыдущий агент**: {last_assistant or '(оборвалось на полпути)'}\n"
        f"- **Изменённые файлы**: {', '.join(Path(f).name for f in mfiles[:10]) if mfiles else '(нет)'}\n\n"
        f"Прочитай `.agy-bridge/LIVE_STATE.md` и `HANDOFF_CONTEXT.md` в `{active_ws}` и сразу продолжи выполнение задачи с того шага, где остановились."
    )

    action_result: Dict[str, Any] = {"targetAgent": to_agent_norm, "spawned": False}
    if spawn:
        if to_agent_norm == "agy":
            rc, cid, out, err = start_agy_cascade(project_id, recovery_prompt, timeout=30)
            if not cid:
                convs = list_agy_conversations(project_id=project_id, workspace_path=active_ws)
                if convs:
                    cid = convs[0]["cascadeId"]
            if focus and cid:
                focus_agy_conversation(cid, project_id=project_id)
            action_result = {"targetAgent": "agy", "spawned": (rc == 0), "cascadeId": cid, "returnCode": rc, "error": err}
        elif to_agent_norm == "claude":
            rc, sock_info, err = send_claude_socket_message(str(active_ws), recovery_prompt)
            if rc == 0:
                action_result = {"targetAgent": "claude", "spawned": True, "mode": "live_socket", "socket": sock_info.get("socketPath")}
            else:
                if latest_session and source_agent != "claude":
                    export_to_claude_jsonl(latest_session, active_ws)
                action_result = {"targetAgent": "claude", "spawned": False, "mode": "prepared_workspace", "note": err}
        elif to_agent_norm == "codex":
            register_in_codex(all_git_paths)
            action_result = {"targetAgent": "codex", "spawned": True, "mode": "registered_in_codex"}

    live_state_path = active_ws / ".agy-bridge" / "LIVE_STATE.md"
    live_state_text = live_state_path.read_text(encoding="utf-8", errors="replace") if live_state_path.exists() else ""

    return {
        "project": project_name,
        "projectId": project_id,
        "baseRepo": str(base_repo),
        "activeWorkspace": str(active_ws),
        "headSha": head_sha,
        "gitStatus": status_out,
        "sourceAgent": source_agent,
        "sourceSessionId": source_sid,
        "sourceTurns": len(all_turns),
        "initialGoal": init_goal,
        "lastPrompt": last_user,
        "lastOutcome": last_assistant,
        "modifiedFiles": mfiles,
        "recoveryPrompt": recovery_prompt,
        "action": action_result,
        "liveState": live_state_text,
        "handoffFile": written_handoffs[0] if written_handoffs else "",
    }


def cmd_continue(args: argparse.Namespace) -> int:
    target_proj = getattr(args, "target", None) or getattr(args, "target_project", None) or getattr(args, "workspace", None)
    to_agent = getattr(args, "to", None)
    if target_proj and str(target_proj).lower() in ("agy", "antigravity", "claude", "codex") and not to_agent:
        to_agent = str(target_proj).lower()
        target_proj = getattr(args, "target_project", None) or getattr(args, "workspace", None)

    res = execute_continue_failover(
        target_project=target_proj,
        to_agent=to_agent,
        custom_prompt=getattr(args, "prompt", None),
        focus=not getattr(args, "no_focus", False),
        spawn=not getattr(args, "no_chat", False),
    )
    if getattr(args, "json", False):
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return 0

    print(f"⚡️ [agy-bridge] Continued project '{res['project']}' ({res['sourceAgent']} -> {res['action'].get('targetAgent')})")
    print(f"  Workspace      : {res['activeWorkspace']} (HEAD={res['headSha']})")
    print(f"  Source Session : [{res['sourceAgent']}] {res['sourceSessionId']} ({res['sourceTurns']} turns)")
    if res.get("lastPrompt"):
        print(f"  Last Prompt    : {res['lastPrompt'][:140]}")
    act = res.get("action", {})
    if act.get("cascadeId"):
        print(f"  Antigravity UI : Spawned & focused cascade_id={act['cascadeId']}")
    elif act.get("socket"):
        print(f"  Claude Socket  : Injected into live socket {act['socket']}")
    else:
        print(f"  Target Status  : Ready in {act.get('targetAgent')} ({act.get('mode', 'synced')})")
    return 0


