# Worktree & Project Path Resolution
# ---------------------------------------------------------------------------

def load_claude_worktrees() -> Dict[str, Dict[str, Any]]:
    """Returns mapping of worktree_path -> metadata from git-worktrees.json."""
    if not CLAUDE_WORKTREES_FILE.exists():
        return {}
    try:
        data = json.loads(CLAUDE_WORKTREES_FILE.read_text(encoding="utf-8"))
        wt = data.get("worktrees", {})
        if isinstance(wt, dict):
            return wt
    except Exception:
        pass
    return {}


def find_worktrees_for_repo(repo_path: Path) -> List[Path]:
    """Finds all worktrees belonging to repo_path (or if repo_path is inside a worktree, resolves both)."""
    resolved = repo_path.expanduser().resolve()
    worktrees: List[Path] = []
    wt_map = load_claude_worktrees()
    for wt_path_str, info in wt_map.items():
        orig = info.get("originalRepoPath", "")
        wt_p = Path(wt_path_str)
        if orig and Path(orig).resolve() == resolved and wt_p.exists():
            worktrees.append(wt_p.resolve())
    local_wt_dir = resolved / ".claude" / "worktrees"
    if local_wt_dir.is_dir():
        for child in sorted(local_wt_dir.iterdir(), key=lambda x: x.stat().st_mtime if x.exists() else 0, reverse=True):
            if child.is_dir() and child.resolve() not in worktrees:
                worktrees.append(child.resolve())
    return worktrees


def resolve_repo_and_worktree(target_path: Path) -> Tuple[Path, Path, List[Path]]:
    """
    Given either a base repo path or a worktree path:
    Returns (base_repo_path, active_workspace_path, all_git_paths).
    Active workspace is the worktree if it has a newer CLAUDE.md or recent git activity, else base_repo_path.
    """
    resolved = target_path.expanduser().resolve()
    parts = resolved.parts
    # Check if resolved is itself inside <base>/.claude/worktrees/<wt_name>
    if ".claude" in parts:
        idx = parts.index(".claude")
        if idx + 1 < len(parts) and parts[idx + 1] == "worktrees":
            base_repo = Path(*parts[:idx]).resolve()
            wt_root = Path(*parts[: idx + 3]).resolve() if idx + 2 < len(parts) else resolved
            all_paths = [wt_root]
            if base_repo.exists() and base_repo not in all_paths:
                all_paths.append(base_repo)
            return base_repo, wt_root, all_paths

    # Check git-worktrees.json in case it's an external worktree
    wt_map = load_claude_worktrees()
    if str(resolved) in wt_map:
        orig = wt_map[str(resolved)].get("originalRepoPath")
        if orig and Path(orig).exists():
            base_repo = Path(orig).resolve()
            return base_repo, resolved, [resolved, base_repo]

    # Otherwise resolved is the base repo; check if it has worktrees
    worktrees = find_worktrees_for_repo(resolved)
    if not worktrees:
        return resolved, resolved, [resolved]

    # Pick the best worktree if its CLAUDE.md or HEAD is newer than base_repo's CLAUDE.md
    best_wt = worktrees[0]
    base_claude = resolved / "CLAUDE.md"
    wt_claude = best_wt / "CLAUDE.md"
    active = resolved
    if wt_claude.exists():
        if not base_claude.exists():
            active = best_wt
        else:
            if wt_claude.stat().st_mtime >= base_claude.stat().st_mtime or wt_claude.stat().st_size > base_claude.stat().st_size:
                active = best_wt

    all_paths: List[Path] = []
    if active != resolved:
        all_paths.append(active)
    all_paths.append(resolved)
    for wt in worktrees:
        if wt not in all_paths:
            all_paths.append(wt)
    return resolved, active, all_paths


def resolve_project_input(target: Optional[str]) -> Tuple[Path, str]:
    """Resolves a CLI target (path, name, or None) into (Path, project_name)."""
    if not target:
        cwd = Path.cwd().resolve()
        base, _, _ = resolve_repo_and_worktree(cwd)
        return cwd, base.name

    expanded = Path(target).expanduser()
    if expanded.is_absolute() or "/" in target or target.startswith("."):
        p = expanded.resolve()
        base, _, _ = resolve_repo_and_worktree(p)
        return p, base.name

    # Check if it matches an existing Antigravity project name or ID
    for proj in list_agy_projects():
        if proj.get("id") == target or proj.get("name", "").lower() == target.lower():
            for uri in extract_project_uris(proj):
                p = Path(uri_to_path(uri))
                if p.exists():
                    return p, proj.get("name", p.name)

    # Check ~/Documents/<target>
    doc_candidate = DEFAULT_DOCS_DIR / target
    if doc_candidate.exists() or DEFAULT_DOCS_DIR.exists():
        return doc_candidate.resolve(), target

    p = Path(target).resolve()
    return p, p.name


