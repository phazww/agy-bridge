def register_in_claude_presets(project_path: Path, project_name: Optional[str] = None) -> bool:
    """Registers project folder in ~/Library/Application Support/Claude/ccd-session-presets.json."""
    if not CLAUDE_APP_SUPPORT.exists():
        return False
    data: Dict[str, Any] = {"version": 1, "byAccount": {}}
    if CLAUDE_PRESETS_FILE.exists():
        try:
            data = json.loads(CLAUDE_PRESETS_FILE.read_text(encoding="utf-8"))
        except Exception:
            data = {"version": 1, "byAccount": {}}
    # Remove any bogus root keys from earlier versions
    data.pop("lastNonWorktreePreset", None)
    data.setdefault("version", 1)
    by_account = data.setdefault("byAccount", {})
    if not isinstance(by_account, dict) or not by_account:
        by_account = {"default": {"presets": [], "lastNonWorktreePresetId": None}}
        data["byAccount"] = by_account

    base_repo, _, _ = resolve_repo_and_worktree(project_path)
    p_str = str(base_repo.expanduser().resolve())
    name = project_name or base_repo.name
    now_ms = int(time.time() * 1000)

    for acc_id, acc_obj in by_account.items():
        if not isinstance(acc_obj, dict):
            continue
        presets = acc_obj.setdefault("presets", [])
        if not isinstance(presets, list):
            presets = []
            acc_obj["presets"] = presets
        found_id = None
        for pr in presets:
            if isinstance(pr, dict) and isinstance(pr.get("target"), dict):
                if pr["target"].get("cwd") == p_str:
                    pr["lastUsedAt"] = now_ms
                    pr["name"] = pr.get("name") or name
                    found_id = pr.get("id")
                    break
        if not found_id:
            found_id = str(uuid.uuid5(uuid.NAMESPACE_URL, f"claude-preset:{p_str}"))
            presets.append({
                "id": found_id,
                "name": name,
                "createdAt": now_ms,
                "lastUsedAt": now_ms,
                "target": {
                    "kind": "local",
                    "cwd": p_str,
                },
            })
        acc_obj["lastNonWorktreePresetId"] = found_id

    CLAUDE_PRESETS_FILE.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return True


def list_claude_sessions(limit: int = 15) -> List[Dict[str, Any]]:
    """Discovers Claude Desktop local_*.json metadata + ~/.claude/projects/<slug>/*.jsonl transcripts."""
    desktop_meta_by_cli_id: Dict[str, Dict[str, Any]] = {}
    desktop_sessions: List[Dict[str, Any]] = []

    if CLAUDE_SESSIONS_DIR.exists():
        for lf in sorted(CLAUDE_SESSIONS_DIR.glob("*/*/local_*.json"), key=lambda p: p.stat().st_mtime, reverse=True):
            try:
                d = json.loads(lf.read_text(encoding="utf-8"))
                cli_id = d.get("cliSessionId", "")
                if cli_id:
                    desktop_meta_by_cli_id[cli_id] = d
                desktop_sessions.append(d)
            except Exception:
                continue

    results: List[Dict[str, Any]] = []
    seen_cli_ids = set()

    if CLAUDE_PROJECTS_DIR.exists():
        jsonl_files = sorted(CLAUDE_PROJECTS_DIR.glob("*/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
        for jf in jsonl_files[: limit * 2]:
            session_id = jf.stem
            seen_cli_ids.add(session_id)
            d_meta = desktop_meta_by_cli_id.get(session_id, {})
            cwd = d_meta.get("originCwd") or d_meta.get("cwd") or ""
            wt_path = d_meta.get("worktreePath") or ""
            branch = d_meta.get("worktreeBranch") or ""
            title = d_meta.get("title") or ""
            # Peek lines of jsonl if cwd or title is missing
            if not cwd or not title:
                try:
                    with jf.open("r", encoding="utf-8", errors="replace") as f:
                        for _ in range(30):
                            line = f.readline()
                            if not line:
                                break
                            rec = json.loads(line)
                            if not cwd and rec.get("cwd"):
                                cwd = rec["cwd"]
                            if not branch and rec.get("gitBranch"):
                                branch = rec["gitBranch"]
                            if rec.get("type") == "custom-title" and rec.get("customTitle"):
                                title = rec["customTitle"]
                            elif rec.get("type") == "agent-name" and not title and rec.get("agentName"):
                                title = rec["agentName"]
                            elif not title and rec.get("type") == "user":
                                msg = extract_claude_message_text(rec.get("message", {}))
                                if msg and not msg.startswith("<"):
                                    title = msg.strip().replace("\n", " ")[:80]
                except Exception:
                    pass
            results.append({
                "sessionId": session_id,
                "desktopSessionId": d_meta.get("sessionId", ""),
                "title": title or f"Claude session {session_id[:8]}",
                "cwd": cwd,
                "worktreePath": wt_path,
                "branch": branch,
                "model": d_meta.get("model", ""),
                "jsonlPath": str(jf),
                "sizeBytes": jf.stat().st_size,
                "lastModified": ts_to_iso(jf.stat().st_mtime),
                "mtime": jf.stat().st_mtime,
            })

    # Include any desktop sessions whose jsonl wasn't created yet
    for d in desktop_sessions:
        cli_id = d.get("cliSessionId", "")
        if cli_id and cli_id in seen_cli_ids:
            continue
        ts = d.get("lastActivityAt") or d.get("createdAt") or 0
        results.append({
            "sessionId": cli_id or d.get("sessionId", ""),
            "desktopSessionId": d.get("sessionId", ""),
            "title": d.get("title") or "(New Desktop Session)",
            "cwd": d.get("originCwd") or d.get("cwd") or "",
            "worktreePath": d.get("worktreePath") or "",
            "branch": d.get("worktreeBranch") or "",
            "model": d.get("model", ""),
            "jsonlPath": "",
            "sizeBytes": 0,
            "lastModified": ts_to_iso(ts),
            "mtime": ts / 1000.0 if ts > 1e11 else ts,
        })

    results.sort(key=lambda x: x.get("mtime", 0), reverse=True)
    return results[:limit]


