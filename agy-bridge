def start_agy_cascade(
    project_id: str,
    prompt: str,
    timeout: int = 20,
) -> Tuple[int, str, Dict[str, Any], str]:
    """
    Starts a new top-level Antigravity conversation in `project_id` via `StartCascade`
    and sends `prompt` via `SendUserCascadeMessage`.
    """
    start_payload: Dict[str, Any] = {
        "source": "CORTEX_TRAJECTORY_SOURCE_CASCADE_CLIENT",
        "trajectoryType": "CORTEX_TRAJECTORY_TYPE_CASCADE",
        "projectEnvConfig": {
            "projectId": project_id,
            "defaultProjectEnvironment": {},
        },
    }
    ok, resp = agy_rpc("StartCascade", start_payload, timeout=timeout)
    if not ok or not resp.get("cascadeId"):
        return 1, "", resp, str(resp.get("error", "StartCascade failed"))

    cascade_id = resp["cascadeId"]
    if prompt:
        msg_payload: Dict[str, Any] = {
            "cascadeId": cascade_id,
            "items": [{"text": prompt}],
            "cascadeConfig": DEFAULT_CASCADE_CONFIG,
        }
        ok_msg, msg_resp = agy_rpc("SendUserCascadeMessage", msg_payload, timeout=timeout)
        if not ok_msg:
            return 1, cascade_id, msg_resp, str(msg_resp.get("error", "SendUserCascadeMessage failed"))

    return 0, cascade_id, resp, ""


def send_agy_cascade_message(
    cascade_id: str,
    message: str,
    timeout: int = 20,
) -> Tuple[int, Dict[str, Any], str]:
    """Sends a user message to an existing Antigravity conversation via `SendUserCascadeMessage`."""
    msg_payload: Dict[str, Any] = {
        "cascadeId": cascade_id,
        "items": [{"text": message}],
        "cascadeConfig": DEFAULT_CASCADE_CONFIG,
    }
    ok, resp = agy_rpc("SendUserCascadeMessage", msg_payload, timeout=timeout)
    if ok:
        return 0, resp, ""
    return 1, resp, str(resp.get("error", "SendUserCascadeMessage failed"))



def list_agy_projects_from_disk() -> List[Dict[str, Any]]:
    projects: List[Dict[str, Any]] = []
    if not AGY_PROJECTS_DIR.exists():
        return projects
    for pf in sorted(AGY_PROJECTS_DIR.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True):
        try:
            data = json.loads(pf.read_text(encoding="utf-8"))
            if isinstance(data, dict) and data.get("id"):
                projects.append(data)
        except Exception:
            continue
    return projects


def list_agy_projects() -> List[Dict[str, Any]]:
    disk_list = list_agy_projects_from_disk()
    disk_by_id = {p["id"]: p for p in disk_list if p.get("id")}
    disk_order = {p["id"]: idx for idx, p in enumerate(disk_list) if p.get("id")}

    ok, resp = agy_rpc("ListProjects", {})
    if ok and ("projectIds" in resp or "projects" in resp):
        rpc_projects: List[Dict[str, Any]] = []
        if "projects" in resp and isinstance(resp["projects"], list):
            rpc_projects = resp["projects"]
        elif "projectIds" in resp and isinstance(resp["projectIds"], list):
            pids = [pid for pid in resp["projectIds"] if isinstance(pid, str) and pid]
            ok_rp, rp_resp = agy_rpc("ReadProjects", {"ids": pids}, timeout=5)
            if ok_rp and isinstance(rp_resp.get("projects"), list):
                rpc_projects = rp_resp["projects"]
            else:
                for pid in pids:
                    ok_one, one_resp = agy_rpc("ReadProject", {"id": pid}, timeout=3)
                    if ok_one and isinstance(one_resp.get("project"), dict):
                        rpc_projects.append(one_resp["project"])

        if rpc_projects:
            merged_by_id: Dict[str, Dict[str, Any]] = dict(disk_by_id)
            for p in rpc_projects:
                pid = p.get("id", "")
                if not pid:
                    continue
                item = dict(disk_by_id.get(pid, {}))
                item.update(p)
                if not extract_project_uris(item) and extract_project_uris(disk_by_id.get(pid, {})):
                    item["projectResources"] = disk_by_id[pid]["projectResources"]
                merged_by_id[pid] = item
            merged = list(merged_by_id.values())
            merged.sort(key=lambda x: (x.get("id") == "outside-of-project", disk_order.get(x.get("id", ""), 999)))
            return merged
    return disk_list


def register_or_update_agy_project(
    project_name: str,
    git_paths: List[Path],
    preferred_id: Optional[str] = None,
) -> Dict[str, Any]:
    """
    Registers or updates a project in Antigravity with full Turbo/Allow/Eager settings
    and all associated gitFolder.folderUri URIs (both worktree and base repo).
    """
    existing_projects = list_agy_projects()
    target_uris = [path_to_uri(p) for p in git_paths]
    matched_proj: Optional[Dict[str, Any]] = None

    for proj in existing_projects:
        if preferred_id and proj.get("id") == preferred_id:
            matched_proj = proj
            break
        if proj.get("name", "").lower() == project_name.lower():
            matched_proj = proj
            break
        for u in extract_project_uris(proj):
            norm_u = path_to_uri(Path(uri_to_path(u)))
            if norm_u in target_uris:
                matched_proj = proj
                break
        if matched_proj:
            break

    project_id = matched_proj["id"] if matched_proj else ""

    if not project_id:
        ok, create_resp = agy_rpc("CreateProject", {"name": project_name})
        if ok and create_resp.get("project", {}).get("id"):
            created_p = create_resp["project"]
            project_id = created_p["id"]
        else:
            project_id = preferred_id or str(uuid.uuid4())

    # Merge existing resources with target_uris (putting primary git_paths first, always normalized to file://)
    seen_uris: List[str] = []
    for u in target_uris:
        norm_u = path_to_uri(Path(uri_to_path(u)))
        if norm_u not in seen_uris:
            seen_uris.append(norm_u)
    if matched_proj:
        for u in extract_project_uris(matched_proj):
            p_cand = Path(uri_to_path(u))
            if p_cand.exists():
                norm_u = path_to_uri(p_cand)
                if norm_u not in seen_uris:
                    seen_uris.append(norm_u)

    resources_payload = [{"gitFolder": {"folderUri": u}} for u in seen_uris]
    merged_settings = dict((matched_proj or {}).get("settings", {}))
    merged_settings.update(TURBO_SETTINGS)
    perm_grants = dict((matched_proj or {}).get("permissionGrants", {"v2Migrated": True}))
    perm_grants.setdefault("v2Migrated", True)

    project_obj: Dict[str, Any] = {
        "id": project_id,
        "name": project_name,
        "projectResources": {"resources": resources_payload},
        "permissionGrants": perm_grants,
        "settings": merged_settings,
        "isWorkspaceOnly": False,
    }
    if matched_proj and matched_proj.get("updatedAt"):
        project_obj["updatedAt"] = matched_proj["updatedAt"]

    ok_upd, _ = agy_rpc("UpdateProject", {"project": project_obj})
    if ok_upd:
        ok_rp, rp_resp = agy_rpc("ReadProject", {"id": project_id})
        if ok_rp and isinstance(rp_resp.get("project"), dict):
            project_obj = rp_resp["project"]

    # Ensure disk persistence in ~/.gemini/config/projects/<id>.json
    AGY_PROJECTS_DIR.mkdir(parents=True, exist_ok=True)
    proj_file = AGY_PROJECTS_DIR / f"{project_id}.json"
    proj_file.write_text(json.dumps(project_obj, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

    return project_obj


def list_agy_conversations(project_id: Optional[str] = None, workspace_path: Optional[Path] = None, top_level_only: bool = True) -> List[Dict[str, Any]]:
    """Lists Antigravity conversations via GetAllCascadeTrajectories with fallback to disk."""
    results: List[Dict[str, Any]] = []
    ws_uri = path_to_uri(workspace_path) if workspace_path else None

    ok, resp = agy_rpc("GetAllCascadeTrajectories", {})
    if ok and "trajectorySummaries" in resp:
        summaries = resp["trajectorySummaries"]
        for cid, info in summaries.items():
            meta = info.get("trajectoryMetadata", {})
            parent_id = meta.get("parentConversationId", "")
            if top_level_only and parent_id:
                continue
            pid = meta.get("projectId", "")
            w_uris = meta.get("workspaceUris", []) or [
                w.get("workspaceFolderAbsoluteUri", "") for w in meta.get("workspaces", [])
            ]
            if project_id and pid != project_id:
                if not (ws_uri and ws_uri in w_uris):
                    continue
            elif ws_uri and ws_uri not in w_uris:
                continue
            results.append({
                "cascadeId": cid,
                "summary": info.get("summary", "(Untitled)"),
                "stepCount": info.get("stepCount", 0),
                "status": info.get("status", ""),
                "lastModifiedTime": info.get("lastModifiedTime", ""),
                "createdTime": info.get("createdTime", ""),
                "projectId": pid,
                "parentConversationId": parent_id,
                "workspaceUris": w_uris,
            })
        results.sort(key=lambda x: x.get("lastModifiedTime", ""), reverse=True)
        return results

    # Fallback: scan ~/.gemini/antigravity/brain/*
    if AGY_BRAIN_DIR.exists():
        for d in sorted(AGY_BRAIN_DIR.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True):
            if d.is_dir() and is_uuid(d.name):
                tr = d / ".system_generated" / "logs" / "transcript.jsonl"
                if tr.exists():
                    results.append({
                        "cascadeId": d.name,
                        "summary": f"Brain session {d.name[:8]}",
                        "stepCount": 0,
                        "status": "DISK",
                        "lastModifiedTime": ts_to_iso(tr.stat().st_mtime),
                        "projectId": "",
                        "workspaceUris": [],
                    })
    return results


def focus_agy_conversation(cascade_id: str, project_id: Optional[str] = None) -> Tuple[bool, Dict[str, Any]]:
    """
    Focuses an Antigravity conversation in the desktop UI.
    Tries `SmartFocusConversation` first (IDE extension mode), then falls back to
    `RecordChatPanelSession` + Electron deep-link `antigravity://open?project=<id>`
    for Antigravity 2.0 standalone Hub mode.
    """
    ok, resp = agy_rpc("SmartFocusConversation", {"cascadeId": cascade_id})
    if ok:
        return True, resp

    if not project_id:
        for c in list_agy_conversations(top_level_only=False):
            if c.get("cascadeId") == cascade_id and c.get("projectId"):
                project_id = c["projectId"]
                break

    ok_rec, rec_resp = agy_rpc("RecordChatPanelSession", {"cascadeId": cascade_id})
    deep_link = f"antigravity://open?project={project_id}" if project_id else "antigravity://open"
    try:
        subprocess.run(["/usr/bin/open", deep_link], capture_output=True, timeout=5)
        return True, {"method": "deep_link", "url": deep_link, "cascadeId": cascade_id, "recorded": ok_rec}
    except Exception as exc:
        if ok_rec:
            return True, rec_resp
        return False, {"error": str(exc), "rpcError": resp}


