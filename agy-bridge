    }


def parse_codex_jsonl(jsonl_path: Path, max_turns: int = 0) -> Dict[str, Any]:
    turns: List[Dict[str, str]] = []
    modified_files: List[str] = []
    read_files: List[str] = []
    touched_files: List[str] = []
    cwd = ""
    title = ""
    session_id = jsonl_path.stem
    mtime = jsonl_path.stat().st_mtime if jsonl_path.exists() else 0.0
    try:
        with jsonl_path.open("r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                payload = rec.get("payload", {})
                if rec.get("type") == "session_meta" and isinstance(payload, dict):
                    cwd = payload.get("cwd", cwd)
                    session_id = payload.get("id", session_id)
                elif rec.get("type") == "response_item" and isinstance(payload, dict):
                    role = payload.get("role", "")
                    if role in ("user", "assistant"):
                        content = payload.get("content", [])
                        parts = []
                        if isinstance(content, list):
                            for c in content:
                                if isinstance(c, dict) and c.get("text"):
                                    parts.append(c["text"].strip())
                        txt = "\n".join(parts).strip()
                        if txt and not txt.startswith("<permissions"):
                            turns.append({"role": role, "text": txt, "timestamp": rec.get("timestamp", "")})
    except Exception:
        pass

    initial_goal = ""
    for t in turns:
        if t.get("role") == "user" and t.get("text"):
            initial_goal = t["text"]
            break
    if not title and initial_goal:
        title = initial_goal.replace("\n", " ")[:90]

    selected_turns = turns if (max_turns <= 0 or len(turns) <= max_turns) else turns[-max_turns:]
    return {
        "agent": "codex",
        "sessionId": session_id,
        "title": title or f"Codex {session_id[:8]}",
        "sourcePath": str(jsonl_path),
        "cwd": cwd,
        "branch": "",
        "mtime": mtime,
        "lastModified": ts_to_iso(mtime),
        "initialUserGoal": initial_goal,
        "totalTurns": len(turns),
        "allTurns": turns,
        "turns": selected_turns,
        "modifiedFiles": modified_files,
        "readFiles": read_files,
        "touchedFiles": touched_files,
    }


def strip_auto_state_block(md_text: str) -> str:
    """Removes any existing standalone <!-- AGY-BRIDGE:AUTO-STATE:START --> ... <!-- AGY-BRIDGE:AUTO-STATE:END --> block."""
    pattern = re.compile(
        r"\n*^" + re.escape(AUTO_STATE_START) + r"\s*\n.*?^" + re.escape(AUTO_STATE_END) + r"\s*$",
        flags=re.DOTALL | re.MULTILINE,
    )
    return pattern.sub("", md_text).rstrip() + "\n"


def select_representative_sessions(all_parsed_sessions: List[Dict[str, Any]], max_sessions: int = 6) -> List[Dict[str, Any]]:
    """
    Selects the latest session from EVERY active agent first (so no IDE's context is ever overshadowed by another),
    then fills up to `max_sessions` with the most recent remaining sessions.
    """
    selected: List[Dict[str, Any]] = []
    seen_ids = set()
    seen_agents = set()

    sorted_all = sorted(all_parsed_sessions, key=lambda s: s.get("mtime", 0), reverse=True)
    for s in sorted_all:
        ag = s.get("agent", "")
        sid = s.get("sessionId", "")
        if ag and ag not in seen_agents and s.get("totalTurns", 0) > 0:
            seen_agents.add(ag)
            seen_ids.add(sid)
            selected.append(s)

    for s in sorted_all:
        if len(selected) >= max_sessions:
            break
        sid = s.get("sessionId", "")
        if sid not in seen_ids and s.get("totalTurns", 0) > 0:
            seen_ids.add(sid)
            selected.append(s)

    selected.sort(key=lambda s: s.get("mtime", 0), reverse=True)
    return selected


def persist_sessions_to_sqlite(
    base_repo: Path,
    all_parsed_sessions: List[Dict[str, Any]],
) -> None:
    """Persists all parsed sessions and their FTS5 searchable transcripts into `<git-common-dir>/agy-bridge/state.sqlite`."""
    try:
        _, head_sha, _ = run_git(base_repo, ["rev-parse", "--short", "HEAD"])
        conn = get_repo_sqlite_conn(base_repo)
        cur = conn.cursor()
        for ps in all_parsed_sessions:
            sid = ps.get("sessionId", "")
            if not sid or sid == "none":
                continue
            ag = ps.get("agent", "agent")
            all_turns = ps.get("allTurns") or ps.get("turns") or []
            init_goal = extract_clean_progress_text(ps.get("initialUserGoal") or "", max_chars=400)
            last_user = ""
            last_assistant = ""
            for t in reversed(all_turns):
                if not last_assistant and t.get("role") == "assistant":
                    cand = extract_clean_progress_text(t.get("text") or "", max_chars=500)
                    if cand and not cand.startswith("*(Executed tools:"):
                        last_assistant = cand
                elif not last_user and t.get("role") == "user":
                    last_user = extract_clean_progress_text(t.get("text") or "", max_chars=400)
                if last_user and last_assistant:
                    break
            safe_sid = re.sub(r"[^a-zA-Z0-9_.-]", "_", sid)
            rel_mirror = f".agy-bridge/sessions/{ag}_{safe_sid}.md"

            cur.execute(
                """
                INSERT INTO sessions (
                    session_id, agent, title, cwd, branch, head_sha, total_turns,
                    initial_goal, last_prompt, last_outcome, modified_files_json, read_files_json,
                    mirror_path, mtime, updated_at
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(session_id) DO UPDATE SET
                    title=excluded.title,
                    cwd=excluded.cwd,
                    branch=excluded.branch,
                    head_sha=excluded.head_sha,
                    total_turns=excluded.total_turns,
                    initial_goal=excluded.initial_goal,
                    last_prompt=excluded.last_prompt,
                    last_outcome=excluded.last_outcome,
                    modified_files_json=excluded.modified_files_json,
                    read_files_json=excluded.read_files_json,
                    mirror_path=excluded.mirror_path,
                    mtime=excluded.mtime,
                    updated_at=excluded.updated_at
                """,
                (
                    sid,
                    ag,
                    ps.get("title", ""),
                    ps.get("cwd", ""),
                    ps.get("branch", ""),
                    head_sha or "",
                    len(all_turns),
                    redact_secrets(init_goal),
                    redact_secrets(last_user),
                    redact_secrets(last_assistant),
                    json.dumps(ps.get("modifiedFiles") or [], ensure_ascii=False),
                    json.dumps(ps.get("readFiles") or [], ensure_ascii=False),
                    rel_mirror,
                    float(ps.get("mtime") or time.time()),
                    ps.get("lastModified") or now_iso(),
                ),
            )
            try:
                full_txt = redact_secrets("\n\n".join((t.get("text") or "") for t in all_turns))
                cur.execute("DELETE FROM session_fts WHERE session_id = ?", (sid,))
                cur.execute(
                    "INSERT INTO session_fts (session_id, agent, title, transcript_text) VALUES (?, ?, ?, ?)",
                    (sid, ag, ps.get("title", ""), full_txt),
                )
            except Exception:
                pass
        conn.commit()
        conn.close()
    except Exception:
        pass


def record_repo_decision(
    base_repo: Path,
    summary: str,
    reason: str = "",
    kind: str = "decision",
    agent: str = "agent",
    session_id: str = "",
    files: Optional[List[str]] = None,
) -> Dict[str, Any]:
    """Records an architectural decision or dead-end in the shared SQLite WAL database."""
    _, head_sha, _ = run_git(base_repo, ["rev-parse", "--short", "HEAD"])
    ts = now_iso()
    conn = get_repo_sqlite_conn(base_repo)
    cur = conn.cursor()
    cur.execute(
        """
        INSERT INTO decisions (agent, session_id, kind, summary, reason, files_json, head_sha, created_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """,
        (
            agent,
            session_id,
            kind,
            redact_secrets(summary),
            redact_secrets(reason),
            json.dumps(files or [], ensure_ascii=False),
            head_sha or "",
            ts,
        ),
    )
    row_id = cur.lastrowid
    conn.commit()
    conn.close()
    return {"id": row_id, "kind": kind, "summary": summary, "reason": reason, "headSha": head_sha, "createdAt": ts}


def get_repo_decisions(base_repo: Path, limit: int = 8) -> List[Dict[str, Any]]:
    try:
        conn = get_repo_sqlite_conn(base_repo)
        cur = conn.cursor()
        cur.execute("SELECT * FROM decisions ORDER BY id DESC LIMIT ?", (limit,))
        rows = [dict(r) for r in cur.fetchall()]
        conn.close()
        return rows
    except Exception:
        return []


def record_repo_event(
    base_repo: Path,
    event_type: str,
    agent: str,
    session_id: str,
    cwd: str,
    payload: Dict[str, Any],
) -> None:
    try:
        _, head_sha, _ = run_git(base_repo, ["rev-parse", "--short", "HEAD"])
        conn = get_repo_sqlite_conn(base_repo)
        conn.execute(
            """
            INSERT INTO events (event_type, agent, session_id, cwd, head_sha, payload_json, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)
            """,
            (event_type, agent, session_id, cwd, head_sha or "", redact_secrets(json.dumps(payload, ensure_ascii=False)), now_iso()),
        )
        if event_type == "StopFailure" and session_id:
            conn.execute(
                "UPDATE sessions SET status = 'interrupted', error_info = ? WHERE session_id = ?",
                (redact_secrets(str(payload.get("error") or payload.get("error_details") or "rate_limit_or_error")), session_id),
            )
        conn.commit()
        conn.close()
    except Exception:
        pass


def get_recent_interrupted_events(base_repo: Path, limit: int = 3) -> List[Dict[str, Any]]:
    try:
        conn = get_repo_sqlite_conn(base_repo)
        cur = conn.cursor()
        cur.execute("SELECT * FROM events WHERE event_type = 'StopFailure' ORDER BY id DESC LIMIT ?", (limit,))
        rows = [dict(r) for r in cur.fetchall()]
        conn.close()
        return rows
    except Exception:
        return []


def search_repo_history_fts(base_repo: Path, query: str, limit: int = 8) -> List[Dict[str, Any]]:
    """Searches across all project sessions using SQLite FTS5 (with fallback substring search)."""
    results: List[Dict[str, Any]] = []
    try:
        conn = get_repo_sqlite_conn(base_repo)
        cur = conn.cursor()
        try:
            cur.execute(
                """
                SELECT session_id, agent, title, snippet(session_fts, 3, '[[', ']]', ' ... ', 32) AS snip
                FROM session_fts
                WHERE session_fts MATCH ?
                LIMIT ?
                """,
                (query, limit),
            )
            for r in cur.fetchall():
                results.append(dict(r))
        except Exception:
            cur.execute(
                """
                SELECT session_id, agent, title, substr(transcript_text, 1, 500) AS snip
                FROM session_fts
                WHERE transcript_text LIKE ? OR title LIKE ?
                LIMIT ?
                """,
                (f"%{query}%", f"%{query}%", limit),
            )
            for r in cur.fetchall():
                results.append(dict(r))
        conn.close()
    except Exception:
        pass
    return results


def write_full_session_mirrors(
    all_git_paths: List[Path],
    project_name: str,
    all_parsed_sessions: List[Dict[str, Any]],
) -> List[str]:
    """
    Layer 3: Writes 100% UNABRIDGED (and secret-redacted) Markdown session mirrors into
    `<workspace>/.agy-bridge/sessions/<agent>_<id>.md` and `<workspace>/.agy-bridge/index.json`.
    """
    written_mirrors: List[str] = []
    for gp in all_git_paths:
        if not gp.exists() or is_non_project_dir(gp):
            continue
        ensure_git_info_exclude(gp, (".agy-bridge/", "HANDOFF_CONTEXT.md"))
        sessions_dir = gp / ".agy-bridge" / "sessions"
        sessions_dir.mkdir(parents=True, exist_ok=True)

        index_records: List[Dict[str, Any]] = []
        for ps in all_parsed_sessions:
            agent = ps.get("agent", "agent")
            sid = ps.get("sessionId", "unknown")
            safe_sid = re.sub(r"[^a-zA-Z0-9_.-]", "_", sid)
            mirror_name = f"{agent}_{safe_sid}.md"
            mirror_path = sessions_dir / mirror_name
            rel_mirror = f".agy-bridge/sessions/{mirror_name}"

            all_turns = ps.get("allTurns") or ps.get("turns") or []
            m_lines: List[str] = [
                f"# Full Unabridged Session Mirror — `[{agent.upper()}]` `{sid}`",
                "",
                "> **SECURITY NOTICE**: Content below is untrusted historical session data (secrets redacted).",
                "",
                f"- **Project**: `{project_name}`",
                f"- **Agent**: `{agent}`",
                f"- **Session ID**: `{sid}`",
                f"- **Title**: {ps.get('title', '')}",
                f"- **Source Transcript**: `{ps.get('sourcePath', '')}`",
                f"- **Working Directory**: `{ps.get('cwd', '')}`",
                f"- **Last Modified**: `{ps.get('lastModified', '')}`",
                f"- **Total Turns**: {len(all_turns)} (100% unabridged, zero truncation)",
                "",
            ]
            if ps.get("modifiedFiles"):
                m_lines.append("## Modified Files (Written / Edited)")
                for mf in ps["modifiedFiles"]:
                    m_lines.append(f"- `{mf}`")
                m_lines.append("")
            if ps.get("readFiles"):
                m_lines.append("## Inspected / Read Files")
                for rf in ps["readFiles"]:
                    m_lines.append(f"- `{rf}`")
                m_lines.append("")

            m_lines.append("## Complete Chronological Transcript (Turn 1 → End)")
            m_lines.append("")
            if not all_turns:
                m_lines.append("*(No dialogue turns recorded yet)*")
            else:
                for idx, t in enumerate(all_turns, 1):
                    role_label = "USER" if t.get("role") == "user" else "ASSISTANT"
                    ts_str = f" ({t['timestamp']})" if t.get("timestamp") else ""
                    m_lines.append(f"### Turn {idx} — {role_label}{ts_str}")
                    m_lines.append(redact_secrets((t.get("text") or "").strip()))
                    m_lines.append("")

            atomic_write_text(mirror_path, "\n".join(m_lines) + "\n", mode=0o600)
            written_mirrors.append(str(mirror_path))
            index_records.append({
                "agent": agent,
                "sessionId": sid,
                "title": ps.get("title", ""),
                "lastModified": ps.get("lastModified", ""),
                "totalTurns": len(all_turns),
                "modifiedFiles": ps.get("modifiedFiles", []),
                "readFiles": ps.get("readFiles", []),
                "mirrorRelativePath": rel_mirror,
                "sourcePath": ps.get("sourcePath", ""),
            })

        idx_file = gp / ".agy-bridge" / "index.json"
        atomic_write_text(
            idx_file,
            json.dumps({
                "project": project_name,
                "updatedAt": now_iso(),
                "sessions": index_records,
            }, indent=2, ensure_ascii=False) + "\n",
            mode=0o600,
        )
    return written_mirrors


def extract_clean_progress_text(raw_turn_text: str, max_chars: int = 380) -> str:
    """
    Strips raw `[Thinking / Reasoning]`, `[Tool Call]`, `[Tool Result]`, and `<system-reminder>` noise from a turn
    so Layer 1 (CLAUDE.md / AGENTS.md) stays a crisp, ~400-token Progress State that doesn't burn rate limits,
    while full reasoning and tool outputs remain on disk in HANDOFF_CONTEXT.md and .agy-bridge/sessions/.
    """
    cleaned_raw = re.sub(r"<system-reminder>.*?</system-reminder>", "", raw_turn_text or "", flags=re.DOTALL)
    clean_lines: List[str] = []
    tool_names: List[str] = []
    for line in cleaned_raw.splitlines():
        s = line.strip()
        if not s:
            continue
        if s.startswith("> **[Thinking / Reasoning]**:"):
            continue
        if s.startswith("[Tool Call:"):
            m = re.match(r"^\[Tool Call:\s*`?([^`\]]+)`?", s)
            if m and m.group(1) not in tool_names:
                tool_names.append(m.group(1))
            continue
        if s.startswith("[Tool Result]:") or s.startswith("[Tool Error]:"):
            continue
        if s.startswith("... [") and "omitted" in s:
            continue
        clean_lines.append(s)

    joined = " ".join(clean_lines).strip()
    if not joined and tool_names:
        joined = f"*(Executed tools: {', '.join(tool_names[:6])})*"
    if len(joined) > max_chars:
        joined = joined[:max_chars].rstrip() + " ..."
    return joined


def build_auto_state_block(
    project_name: str,
    active_workspace: Path,
    agy_project_id: str,
    all_parsed_sessions: List[Dict[str, Any]],
    matched_sessions: List[Dict[str, Any]],
    max_budget_bytes: int = 4500,
) -> str:
    """
    Layer 1: Builds the token-efficient (~400-token) Zero-Prompt `<!-- AGY-BRIDGE:AUTO-STATE:START/END -->`
    Progress State block injected into `CLAUDE.md` and `AGENTS.md`.
    Why compact here + full on disk:
      - `CLAUDE.md` / `AGENTS.md` are loaded on EVERY turn; dumping raw transcripts burns rate limits and causes context rot.
      - This block gives every agent the exact live state (Modified Files Matrix, Git status/diff stat, and clean last progress per IDE),
        while pointing to `HANDOFF_CONTEXT.md` (Layer 2) and `.agy-bridge/sessions/*.md` (Layer 3) for 0-token on-demand deep lookup.
    """
    _, branch_out, _ = run_git(active_workspace, ["branch", "--show-current"])
    _, head_sha, _ = run_git(active_workspace, ["rev-parse", "--short", "HEAD"])
    _, status_out, _ = run_git(active_workspace, ["status", "-s"])
    _, diff_stat, _ = run_git(active_workspace, ["diff", "--stat"])
    _, log_out, _ = run_git(active_workspace, ["log", "-n", "5", "--oneline"])

    rep_sessions = select_representative_sessions(all_parsed_sessions, max_sessions=4)
    decisions = get_repo_decisions(active_workspace, limit=6)
    interrupted = get_recent_interrupted_events(active_workspace, limit=2)

    lines: List[str] = []
    lines.append(AUTO_STATE_START)
    lines.append("## 🔄 Cross-Agent Live Progress State (`agy-bridge v0.3` — Zero-Terminal Auto-Synced)")
    lines.append("")
    lines.append("> **CROSS-AGENT PROTOCOL**: Multiple IDEs (**Antigravity**, **Claude**, **Codex**, **WorkBuddy**) share this repo.")
    lines.append("> Before editing files touched by another agent, check the matrix below. For full reasoning, rejected approaches, and tool logs, read [`HANDOFF_CONTEXT.md`](./HANDOFF_CONTEXT.md) or [`.agy-bridge/sessions/`](./.agy-bridge/sessions/) on demand (or call `bridge_get_state` / `bridge_search_history` via MCP).")
    lines.append("")
    lines.append(
        f"- **Synced**: `{now_iso()}` | **Workspace**: `{active_workspace}` | "
        f"**Branch**: `{branch_out or 'main'}` (`HEAD={head_sha or 'init'}`) | **AGY ID**: `{agy_project_id}`"
    )
    lines.append("")

    if interrupted:
        lines.append("### ⚠️ Recent Interrupted / Rate-Limited Runs (`StopFailure`)")
        for ev in interrupted:
            lines.append(
                f"- **`[{str(ev.get('agent', '')).upper()}]`** session `{ev.get('session_id', '')[:8]}` at `{ev.get('created_at', '')}` "
                f"(`HEAD={ev.get('head_sha', '')}`): `{ev.get('payload_json', '')[:220]}`"
            )
        lines.append("")

    sec_num = 1
    # Section: Cross-Agent Modified Files Matrix + Session Mirrors
    lines.append(f"### {sec_num}. Active Sessions & Modified Files Matrix")
    sec_num += 1
    if rep_sessions:
        for ps in rep_sessions:
            ag = ps.get("agent", "agent")
            sid = ps.get("sessionId", "")
            safe_sid = re.sub(r"[^a-zA-Z0-9_.-]", "_", sid)
            mirror_rel = f"./.agy-bridge/sessions/{ag}_{safe_sid}.md"
            total_t = len(ps.get("allTurns") or ps.get("turns") or [])
            mfiles = ps.get("modifiedFiles") or []
            rfiles = ps.get("readFiles") or []
            m_str = ", ".join(f"`{Path(f).name}`" for f in mfiles[:8]) if mfiles else "*(none)*"
            r_str = ", ".join(f"`{Path(f).name}`" for f in rfiles[:6]) if rfiles else "*(none)*"
            lines.append(
                f"- **`[{ag.upper()}]`** **{ps.get('title', '')}** (`{sid[:8]}`, {total_t} turns, `{ps.get('lastModified', '')}`) → [Full Mirror]({mirror_rel})\n"
                f"  - **Edited**: {m_str} | **Read**: {r_str}"
            )
    else:
        lines.append("- *(No recorded sessions yet)*")
    lines.append("")

    if decisions:
        lines.append(f"### {sec_num}. Shared Architectural Decisions & Dead-Ends (Do Not Repeat)")
        sec_num += 1
        for d in decisions:
            k_tag = "🚫 DEAD-END" if d.get("kind") == "dead_end" else "✅ DECISION"
            r_str = f" — *Reason*: {d['reason']}" if d.get("reason") else ""
            lines.append(f"- **{k_tag}** (`[{str(d.get('agent', '')).upper()}]`, `HEAD={d.get('head_sha', '')}`): {d.get('summary', '')}{r_str}")
        lines.append("")

    # Section: Live Git State
    lines.append(f"### {sec_num}. Live Git State")
    sec_num += 1
    lines.append("```text")
    lines.append(f"# git status -s:\n{status_out or '(clean working tree)'}")
    if diff_stat:
        lines.append(f"\n# git diff --stat:\n{diff_stat}")
    if log_out:
        lines.append(f"\n# git log -n 5 --oneline:\n{log_out}")
    lines.append("```")
    lines.append("")

    # Section: Clean Progress Summary per Active Agent (No raw Thinking/Tool spam)
    if rep_sessions:
        lines.append(f"### {sec_num}. Latest Progress Snapshot (Per Active IDE)")
        for ps in rep_sessions:
            ag = ps.get("agent", "agent")
            sid = ps.get("sessionId", "")
            safe_sid = re.sub(r"[^a-zA-Z0-9_.-]", "_", sid)
            mirror_rel = f"./.agy-bridge/sessions/{ag}_{safe_sid}.md"
            all_turns = ps.get("allTurns") or ps.get("turns") or []
            if not all_turns:
                continue

            init_goal = extract_clean_progress_text(ps.get("initialUserGoal") or "", max_chars=240)
            last_user = ""
            last_assistant = ""
            fallback_tool_assistant = ""
            for t in reversed(all_turns):
                if t.get("role") == "assistant" and not last_assistant:
                    cand = extract_clean_progress_text(t.get("text") or "", max_chars=380)
                    if cand.startswith("*(Executed tools:"):
                        if not fallback_tool_assistant:
                            fallback_tool_assistant = cand
                    elif cand:
                        last_assistant = cand
                elif t.get("role") == "user" and not last_user:
                    last_user = extract_clean_progress_text(t.get("text") or "", max_chars=260)
                if last_user and last_assistant:
                    break
            if not last_assistant and fallback_tool_assistant:
                last_assistant = fallback_tool_assistant

            lines.append(f"- **`[{ag.upper()} {sid[:8]}]`** ([Full Log]({mirror_rel})):")
            if init_goal and init_goal != last_user:
                lines.append(f"  - **Goal**: {init_goal}")
            if last_user:
                lines.append(f"  - **Last Prompt**: {last_user}")
            if last_assistant:
                lines.append(f"  - **Last Outcome**: {last_assistant}")
        lines.append("")

    lines.append(AUTO_STATE_END)
    return redact_secrets("\n".join(lines) + "\n")


def sync_claude_and_agents_md(
    paths: List[Path],
    project_name: str,
    auto_state_block: Optional[str] = None,
    write_tracked_docs: bool = False,
) -> List[str]:
    """
    Synchronizes CLAUDE.md and AGENTS.md across all project paths (worktree + base repo),
    AND writes the live auto-state block into git-ignored `.agy-bridge/LIVE_STATE.md` and
    `<git-common-dir>/agy-bridge/LIVE_STATE.md`.
    By default (`write_tracked_docs=False`), keeps `CLAUDE.md` and `AGENTS.md` 100% clean of auto-blocks
    so `git status` is never dirtied (since hooks inject `LIVE_STATE.md` dynamically at SessionStart / Turn start!).
    """
    synced_files: List[str] = []
    candidates: List[Tuple[int, float, str, Path]] = []
    for p in paths:
        if not p.exists() or is_non_project_dir(p):
            continue
        for fname in ("CLAUDE.md", "AGENTS.md"):
            f = p / fname
            if f.exists() and f.stat().st_size > 0:
                raw_txt = f.read_text(encoding="utf-8", errors="replace")
                clean_human = strip_auto_state_block(raw_txt).strip()
                if clean_human:
                    candidates.append((len(clean_human.encode("utf-8")), f.stat().st_mtime, clean_human, f))

    if not candidates:
        primary = paths[0]
        if is_non_project_dir(primary):
            return synced_files
        primary.mkdir(parents=True, exist_ok=True)
        base_human_doc = (
            f"# {project_name}\n\n"
            f"Project managed and synchronized across **Antigravity 2.0**, **Claude Code / Desktop**, **Codex**, and **WorkBuddy** via `agy-bridge`.\n\n"
            f"- **Workspace Path**: `{primary}`\n"
            f"- **Live Cross-Agent State**: [`.agy-bridge/LIVE_STATE.md`](./.agy-bridge/LIVE_STATE.md)\n"
            f"- **Full Cross-Agent Context**: [`HANDOFF_CONTEXT.md`](./HANDOFF_CONTEXT.md) and [`.agy-bridge/sessions/`](./.agy-bridge/sessions/).\n"
        )
    else:
        candidates.sort(key=lambda item: (item[1], item[0]), reverse=True)
        base_human_doc = candidates[0][2] + "\n"

    final_doc_content = base_human_doc.rstrip() + "\n"
    if write_tracked_docs and auto_state_block:
        final_doc_content = final_doc_content + "\n" + auto_state_block.strip() + "\n"

    for p in paths:
        if not p.exists() or is_non_project_dir(p):
            continue
        ensure_git_info_exclude(p, (".agy-bridge/", "HANDOFF_CONTEXT.md"))
        if auto_state_block:
            live_state_file = p / ".agy-bridge" / "LIVE_STATE.md"
            atomic_write_text(live_state_file, auto_state_block, mode=0o600)
            synced_files.append(str(live_state_file))
            try:
                common_live = get_git_common_bridge_dir(p) / "LIVE_STATE.md"
                atomic_write_text(common_live, auto_state_block, mode=0o600)
            except Exception:
                pass
        for fname in ("CLAUDE.md", "AGENTS.md"):
            target = p / fname
            existing = target.read_text(encoding="utf-8", errors="replace") if target.exists() else ""
            if existing != final_doc_content:
                atomic_write_text(target, final_doc_content)
            synced_files.append(str(target))

    return synced_files


def export_to_claude_jsonl(parsed_session: Dict[str, Any], workspace_path: Path) -> Optional[Path]:
    """Writes/updates a Claude-compatible .jsonl session in ~/.claude/projects/<slug>/<sessionId>.jsonl."""
    slug = path_to_claude_slug(workspace_path)
    proj_dir = CLAUDE_PROJECTS_DIR / slug
    proj_dir.mkdir(parents=True, exist_ok=True)
    sid = parsed_session.get("sessionId") or str(uuid.uuid4())
    if not is_uuid(sid):
        sid = str(uuid.uuid5(uuid.NAMESPACE_DNS, sid))
    out_file = proj_dir / f"{sid}.jsonl"

    lines: List[str] = []
    parent_uuid: Optional[str] = None
    cwd_str = str(workspace_path.resolve())
    all_turns = parsed_session.get("allTurns") or parsed_session.get("turns") or []
    for turn in all_turns:
        msg_uuid = str(uuid.uuid4())
        role = "user" if turn.get("role") == "user" else "assistant"
        ts = turn.get("timestamp") or now_iso()
        rec: Dict[str, Any] = {
            "parentUuid": parent_uuid,
            "isSidechain": False,
            "userType": "external",
            "cwd": cwd_str,
            "sessionId": sid,
            "version": "2.1.317",
            "gitBranch": parsed_session.get("branch") or "main",
            "type": role,
            "uuid": msg_uuid,
            "timestamp": ts,
            "message": {
                "role": role,
                "content": [{"type": "text", "text": turn.get("text", "")}],
            },
        }
        lines.append(json.dumps(rec, ensure_ascii=False))
        parent_uuid = msg_uuid

    if parsed_session.get("title"):
        lines.append(json.dumps({
            "type": "custom-title",
            "customTitle": parsed_session["title"],
            "sessionId": sid,
        }, ensure_ascii=False))

    if lines:
        out_file.write_text("\n".join(lines) + "\n", encoding="utf-8")
        return out_file
    return None


def is_agy_exported_mirror(session_id: str) -> bool:
    """Returns True if session_id corresponds to an Antigravity brain directory (i.e. a --to-claude mirror)."""
    return bool(session_id and (AGY_BRAIN_DIR / session_id).exists())


def discover_project_sessions(
    project_name: str,
    project_id: str,
    all_git_paths: List[Path],
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]], Optional[Dict[str, Any]]]:
    """
    Finds AND parses all sessions across Claude Code/Desktop, Antigravity, WorkBuddy, and Codex belonging to this project.
    Returns (matched_sessions_summary_list, all_parsed_sessions_list, most_recent_parsed_session).
    Never drops other agents' sessions when one agent has a newer timestamp!
    """
    matched_sessions: List[Dict[str, Any]] = []
    all_parsed_sessions: List[Dict[str, Any]] = []
    seen_ids = set()

    path_strs = [str(p.resolve()) for p in all_git_paths if p.exists()]
    base_repo = all_git_paths[-1] if all_git_paths else Path.cwd()

    # 1. Check exact ~/.claude/projects/<slug>/*.jsonl directories for all_git_paths first
    candidate_claude_jsonls: List[Path] = []
    if CLAUDE_PROJECTS_DIR.exists():
        for gp in all_git_paths:
            slug_dir = CLAUDE_PROJECTS_DIR / path_to_claude_slug(gp)
            if slug_dir.exists():
                candidate_claude_jsonls.extend(slug_dir.glob("*.jsonl"))

    for jf in sorted(candidate_claude_jsonls, key=lambda x: x.stat().st_mtime, reverse=True)[:10]:
        sid = jf.stem
        if sid in seen_ids or is_agy_exported_mirror(sid):
            continue
        seen_ids.add(sid)
        parsed = parse_claude_or_workbuddy_jsonl(jf, max_turns=0)
        mtime = jf.stat().st_mtime
        matched_sessions.append({
            "agent": "claude",
            "sessionId": sid,
            "title": parsed.get("title") or f"Claude session {sid[:8]}",
            "lastModified": ts_to_iso(mtime),
            "mtime": mtime,
            "totalTurns": parsed.get("totalTurns", 0),
            "jsonlPath": str(jf),
        })
        all_parsed_sessions.append(parsed)

    # 2. Check list_claude_sessions for any additional matching sessions (e.g. via worktree metadata)
    for cs in list_claude_sessions(limit=50):
        sid = cs["sessionId"]
        if sid in seen_ids or is_agy_exported_mirror(sid):
            continue
        c_cwd = cs.get("cwd", "")
        c_wt = cs.get("worktreePath", "")
        if any(ps in (c_cwd, c_wt) for ps in path_strs) or project_name.lower() in c_cwd.lower() or project_name.lower() in cs.get("jsonlPath", "").lower():
            seen_ids.add(sid)
            parsed_cs: Optional[Dict[str, Any]] = None
            if cs.get("jsonlPath") and Path(cs["jsonlPath"]).exists():
                parsed_cs = parse_claude_or_workbuddy_jsonl(Path(cs["jsonlPath"]), max_turns=0)
                if cs.get("title") and not parsed_cs.get("title"):
                    parsed_cs["title"] = cs["title"]
                if cs.get("branch") and not parsed_cs.get("branch"):
                    parsed_cs["branch"] = cs["branch"]
                all_parsed_sessions.append(parsed_cs)
            matched_sessions.append({
                "agent": "claude",
                "sessionId": sid,
                "title": (parsed_cs or {}).get("title") or cs["title"],
                "lastModified": cs["lastModified"],
                "mtime": cs.get("mtime", 0),
                "totalTurns": (parsed_cs or {}).get("totalTurns", 0),
                "jsonlPath": cs.get("jsonlPath", ""),
            })

    # 3. Antigravity conversations for this project (ALWAYS parse them even if Claude was also active!)
    for ac in list_agy_conversations(project_id=project_id, workspace_path=base_repo)[:8]:
        cid = ac["cascadeId"]
        if cid in seen_ids:
            continue
        seen_ids.add(cid)
        parsed_agy = parse_agy_session(cid, max_turns=0)
        if ac.get("summary") and ac["summary"] != "(Untitled)":
            parsed_agy["title"] = ac["summary"]
        mtime_agy = parsed_agy.get("mtime") or iso_to_epoch(ac.get("lastModifiedTime", ""))
        parsed_agy["mtime"] = mtime_agy
        matched_sessions.append({
            "agent": "antigravity",
            "sessionId": cid,
            "title": parsed_agy.get("title") or ac["summary"],
            "lastModified": ac["lastModifiedTime"] or parsed_agy.get("lastModified", ""),
            "mtime": mtime_agy,
            "totalTurns": parsed_agy.get("totalTurns", 0),
        })
        all_parsed_sessions.append(parsed_agy)

    # 4. WorkBuddy sessions
    for wb in list_workbuddy_sessions(limit=30):
        wid = wb["sessionId"]
        if wid in seen_ids:
            continue
        if any(ps == wb.get("cwd") for ps in path_strs) or project_name.lower() in wb.get("projectSlug", "").lower():
            seen_ids.add(wid)
            parsed_wb: Optional[Dict[str, Any]] = None
            if wb.get("jsonlPath") and Path(wb["jsonlPath"]).exists():
                parsed_wb = parse_claude_or_workbuddy_jsonl(Path(wb["jsonlPath"]), max_turns=0)
                all_parsed_sessions.append(parsed_wb)
            matched_sessions.append({
                "agent": "workbuddy",
                "sessionId": wid,
                "title": wb["title"],
                "lastModified": wb["lastModified"],
                "mtime": wb.get("mtime", 0),
                "totalTurns": (parsed_wb or {}).get("totalTurns", 0),
            })

    # 5. Codex threads
    for th in list_codex_sessions(limit=30).get("threads", []):
        tid = th["id"]
        if tid in seen_ids:
            continue
        if any(ps == th.get("cwd") for ps in path_strs) or project_name.lower() in th.get("cwd", "").lower():
            seen_ids.add(tid)
            parsed_cx: Optional[Dict[str, Any]] = None
            if th.get("rolloutPath") and Path(th["rolloutPath"]).exists():
                parsed_cx = parse_codex_jsonl(Path(th["rolloutPath"]), max_turns=0)
                if th.get("title"):
                    parsed_cx["title"] = th["title"]
                all_parsed_sessions.append(parsed_cx)
            matched_sessions.append({
                "agent": "codex",
                "sessionId": tid,
                "title": th["title"],
                "lastModified": th["updatedAt"],
                "mtime": (parsed_cx or {}).get("mtime", 0),
                "totalTurns": (parsed_cx or {}).get("totalTurns", 0),
            })

    matched_sessions.sort(key=lambda x: x.get("mtime", 0), reverse=True)
    all_parsed_sessions.sort(key=lambda x: x.get("mtime", 0), reverse=True)
    best_parsed = all_parsed_sessions[0] if all_parsed_sessions else None
    return matched_sessions, all_parsed_sessions, best_parsed


def generate_handoff_markdown(
    project_name: str,
    base_repo: Path,
    active_workspace: Path,
    agy_project_id: str,
    parsed_session: Dict[str, Any],
    extra_sessions: Optional[List[Dict[str, Any]]] = None,
    all_parsed_sessions: Optional[List[Dict[str, Any]]] = None,
) -> str:
    """
    Layer 2: Builds a comprehensive, multi-agent, full-fidelity HANDOFF_CONTEXT.md file:
    - Includes ALL active/recent sessions across Claude, Antigravity, Codex, and WorkBuddy (not just 1!)
    - Preserves Initial User Goal (Turn 1), Thinking/Reasoning blocks, Tool Calls + Tool Results/Errors
    - Includes `git log -n 12 --stat`, `git status -s`, and actual uncommitted `git diff` hunks
    - Links directly to 100% unabridged session mirrors in `.agy-bridge/sessions/<agent>_<id>.md`
    """
    _, branch_out, _ = run_git(active_workspace, ["branch", "--show-current"])
    _, status_out, _ = run_git(active_workspace, ["status", "-s"])
    _, log_out, _ = run_git(active_workspace, ["log", "-n", "12", "--stat", "--oneline"])
    _, diff_out, _ = run_git(active_workspace, ["diff", "HEAD"])

    sessions_to_render: List[Dict[str, Any]] = []
    seen_sids = set()
    if parsed_session and parsed_session.get("sessionId") and parsed_session.get("sessionId") != "none":
        sessions_to_render.append(parsed_session)
        seen_sids.add(parsed_session["sessionId"])
    if all_parsed_sessions:
        for s in select_representative_sessions(all_parsed_sessions, max_sessions=8):
            sid = s.get("sessionId", "")
            if sid and sid not in seen_sids:
                sessions_to_render.append(s)
                seen_sids.add(sid)

    lines: List[str] = []
    lines.append(f"# HANDOFF_CONTEXT — `{project_name}` (Full-Fidelity Multi-Agent Bus)")
    lines.append("")
    lines.append(
        f"> Auto-generated by `agy-bridge v0.2` at `{now_iso()}` for lossless cross-agent continuation between "
        f"**Antigravity 2.0**, **Claude Desktop / Code**, **Codex**, and **WorkBuddy**."
    )
    lines.append("> **100% Unabridged Session Mirrors**: Every session's complete Turn 1 → End history (zero truncation) is stored in [`.agy-bridge/sessions/`](./.agy-bridge/sessions/).")
    lines.append("")
    lines.append("## 1. Project & Environment Metadata")
    lines.append(f"- **Project Name**: `{project_name}`")
    lines.append(f"- **Base Repository**: `{base_repo}`")
    lines.append(f"- **Active Workspace / Worktree**: `{active_workspace}`")
    lines.append(f"- **Active Git Branch**: `{branch_out or parsed_session.get('branch') or 'main'}`")
    lines.append(f"- **Antigravity Project ID**: `{agy_project_id}` (Turbo / Allow / Eager enabled)")
    lines.append(f"- **Most Recent Agent**: `{parsed_session.get('agent', 'unknown')}` (`{parsed_session.get('sessionId', '')}`)")
    if parsed_session.get("title"):
        lines.append(f"- **Most Recent Session Title**: {parsed_session['title']}")
    lines.append(f"- **Active Sessions Included Below**: {len(sessions_to_render)} across IDEs")
    lines.append("")

    if extra_sessions:
        lines.append("## 2. All Project Sessions Across Agents & Unabridged Mirrors")
        for es in extra_sessions:
            ag = es.get("agent", "agent")
            sid = es.get("sessionId", "")
            safe_sid = re.sub(r"[^a-zA-Z0-9_.-]", "_", sid)
            mirror_rel = f"./.agy-bridge/sessions/{ag}_{safe_sid}.md"
            t_cnt = es.get("totalTurns", "")
            t_str = f", {t_cnt} turns" if t_cnt != "" else ""
            lines.append(
                f"- **`[{ag.upper()}]`** `{sid}` — **{es.get('title', '')}** "
                f"*(updated: {es.get('lastModified', '')}{t_str})* → [100% Full Mirror]({mirror_rel})"
            )
        lines.append("")

    lines.append("## 3. Git Repository State & Uncommitted Diffs")
    lines.append("### Working Tree Status (`git status -s`)")
    lines.append("```text")
    lines.append(status_out or "(clean working tree)")
    lines.append("```")
    lines.append("")
    lines.append("### Recent Commits (`git log -n 12 --stat --oneline`)")
    lines.append("```text")
    lines.append(log_out or "(no commits)")
    lines.append("```")
    lines.append("")
    if diff_out:
        lines.append("### Uncommitted Code Changes (`git diff HEAD`)")
        lines.append("```diff")
        if len(diff_out) > 16000:
            lines.append(diff_out[:16000] + f"\n... [diff truncated at 16,000 chars of {len(diff_out)} total; run `git diff` for remainder]")
        else:
            lines.append(diff_out)
        lines.append("```")
        lines.append("")

    # Section 4: Cross-Agent File Matrix
    lines.append("## 4. Cross-Agent File Modification Matrix")
    any_files = False
    for s in sessions_to_render:
        ag = s.get("agent", "").upper()
        sid = s.get("sessionId", "")
        mfiles = s.get("modifiedFiles") or []
        rfiles = s.get("readFiles") or []
        if mfiles or rfiles:
            any_files = True
            lines.append(f"### `[{ag}]` `{sid}` — {s.get('title', '')}")
            if mfiles:
                lines.append("- **Modified / Written Files**:")
                for mf in mfiles:
                    lines.append(f"  - `{mf}`")
            if rfiles:
                lines.append("- **Inspected / Read Files**:")
                for rf in rfiles[:25]:
                    lines.append(f"  - `{rf}`")
            lines.append("")
    if not any_files:
        lines.append("*(No file modifications recorded in transcripts yet)*")
        lines.append("")

    # Section 5: Multi-Agent Chronological Session Transcripts (All Active Agents!)
    lines.append("## 5. Multi-Agent Detailed Session Transcripts (Reasoning, Tool Calls & Results)")
    lines.append("")
    if not sessions_to_render:
        lines.append("*(No dialogue turns found across agents yet)*")
        lines.append("")
    else:
        for s_idx, s in enumerate(sessions_to_render, 1):
            ag = s.get("agent", "agent")
            sid = s.get("sessionId", "")
            safe_sid = re.sub(r"[^a-zA-Z0-9_.-]", "_", sid)
            mirror_rel = f"./.agy-bridge/sessions/{ag}_{safe_sid}.md"
            all_turns = s.get("allTurns") or s.get("turns") or []
            total_t = len(all_turns)

            lines.append(f"### 5.{s_idx} `[{ag.upper()}]` {s.get('title', '')} (`{sid}`)")
            lines.append(
                f"- **Source**: `{s.get('sourcePath', '')}` | **Updated**: `{s.get('lastModified', '')}` | "
                f"**Total Turns**: {total_t} | **100% Unabridged Mirror**: [`{mirror_rel}`]({mirror_rel})"
            )
            lines.append("")

            if not all_turns:
                lines.append("*(No dialogue turns recorded in this session)*")
                lines.append("")
                continue

            # If session has > 40 turns, always show Turn 1-2 (Initial Task) + last 38 turns in HANDOFF_CONTEXT.md,
            # while .agy-bridge/sessions/<agent>_<id>.md has 100% of all turns!
            if total_t > 40:
                lines.append("#### 📌 Initial User Goal (Turn 1 — Root Task Specification)")
                lines.append((all_turns[0].get("text") or "").strip())
                lines.append("")
                lines.append(f"> *(Turns 2..{total_t - 35} preserved in full inside [`{mirror_rel}`]({mirror_rel}); showing latest 35 turns below)*")
                lines.append("")
                display_slice = list(enumerate(all_turns[-35:], total_t - 34))
            else:
                display_slice = list(enumerate(all_turns, 1))

            for turn_num, t in display_slice:
                role_label = "USER" if t.get("role") == "user" else "ASSISTANT"
                ts_str = f" ({t['timestamp']})" if t.get("timestamp") else ""
                text = (t.get("text") or "").strip()
                if len(text) > 12000:
                    text = (
                        text[:6000]
                        + f"\n\n... *[middle {len(text) - 12000} chars omitted here; 100% unabridged turn is in [`{mirror_rel}`]({mirror_rel})]* ...\n\n"
                        + text[-6000:]
                    )
                lines.append(f"#### Turn {turn_num} — `[{ag.upper()}]` {role_label}{ts_str}")
                lines.append(text)
                lines.append("")

    lines.append("## 6. Quick Commands for Cross-Agent Continuation")
    lines.append(f"- **Sync all 3 context layers**: `agy-bridge sync \"{active_workspace}\"`")
    lines.append(f"- **Spawn new Antigravity chat**: `agy-bridge spawn-agy \"{active_workspace}\" \"Прочитай HANDOFF_CONTEXT.md и продолжи работу\" --focus`")
    lines.append(f"- **Send message to open Claude Desktop tab**: `agy-bridge send-claude \"{active_workspace}\" \"Прочитай обновлённый CLAUDE.md и HANDOFF_CONTEXT.md\"`")
    lines.append("")
    return "\n".join(lines)


def resolve_claude_session_target(target: str) -> Tuple[Optional[Path], Optional[Dict[str, Any]]]:
    """
    Resolves a Claude session identifier (UUID, local_<uuid>, jsonl path, session title, order ID, or project name/path)
    to (jsonl_path, desktop_meta_dict).
    """
    p = Path(target).expanduser()
    if p.exists() and p.is_file() and p.suffix == ".jsonl":
        return p.resolve(), None
    if p.exists() and p.is_dir():
        base_repo, active_ws, all_paths = resolve_repo_and_worktree(p)
        for gp in all_paths:
            slug_dir = CLAUDE_PROJECTS_DIR / path_to_claude_slug(gp)
            if slug_dir.exists():
                jfs = sorted(
                    [jf for jf in slug_dir.glob("*.jsonl") if not is_agy_exported_mirror(jf.stem)],
                    key=lambda x: x.stat().st_mtime,
                    reverse=True,
                )
                if jfs:
                    return jfs[0].resolve(), None

    clean_id = target.strip()
    if clean_id.endswith(".jsonl"):
        clean_id = clean_id[:-6]
    needle_lower = clean_id.lower()

    # 1. Exact ID or title/cwd substring match in Claude Desktop local_*.json
    if CLAUDE_SESSIONS_DIR.exists():
        title_match_meta: Optional[Dict[str, Any]] = None
        for lf in sorted(CLAUDE_SESSIONS_DIR.glob("*/*/local_*.json"), key=lambda x: x.stat().st_mtime, reverse=True):
            try:
                d = json.loads(lf.read_text(encoding="utf-8"))
                if d.get("sessionId") == clean_id or d.get("cliSessionId") == clean_id or lf.stem == clean_id:
                    cli_id = d.get("cliSessionId", "")
                    if cli_id and CLAUDE_PROJECTS_DIR.exists():
                        matches = list(CLAUDE_PROJECTS_DIR.glob(f"*/{cli_id}.jsonl"))
                        if matches:
                            return matches[0].resolve(), d
                    return None, d
                if title_match_meta is None:
                    d_title = (d.get("title") or "").lower()
                    d_cwd = (d.get("originCwd") or d.get("cwd") or "").lower()
                    if needle_lower and (needle_lower in d_title or needle_lower in d_cwd):
                        title_match_meta = d
            except Exception:
                continue
        if title_match_meta is not None:
            cli_id = title_match_meta.get("cliSessionId", "")
            if cli_id and CLAUDE_PROJECTS_DIR.exists():
                matches = list(CLAUDE_PROJECTS_DIR.glob(f"*/{cli_id}.jsonl"))
                if matches:
                    return matches[0].resolve(), title_match_meta
            return None, title_match_meta

    # 2. Search ~/.claude/projects/*/*.jsonl by filename, slug, or custom-title / agent-name
    if CLAUDE_PROJECTS_DIR.exists():
        direct = list(CLAUDE_PROJECTS_DIR.glob(f"*/{clean_id}.jsonl"))
        if direct:
            return direct[0].resolve(), None

        slug_needle = re.sub(r"[^a-zA-Z0-9]", "-", target).strip("-").lower()
        candidates: List[Path] = []
        all_jfs = sorted(CLAUDE_PROJECTS_DIR.glob("*/*.jsonl"), key=lambda x: x.stat().st_mtime, reverse=True)
        for jf in all_jfs:
            if not is_agy_exported_mirror(jf.stem) and slug_needle and slug_needle in jf.parent.name.lower():
                candidates.append(jf)
        if candidates:
            return candidates[0].resolve(), None

        # Check custom-title / agent-name inside recent jsonl files
        for jf in all_jfs[:40]:
            try:
                with jf.open("r", encoding="utf-8", errors="replace") as f:
                    for line in f:
                        if "custom-title" in line or "agent-name" in line:
                            rec = json.loads(line)
                            ct = (rec.get("customTitle") or rec.get("agentName") or "").lower()
                            if needle_lower and needle_lower in ct:
                                return jf.resolve(), None
            except Exception:
                continue

    return None, None


